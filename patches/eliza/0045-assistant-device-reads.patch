@@ -0,0 +1,167 @@
+/**
+ * Foreground local Notes search beyond titles. Content matching runs on the phone; the
+ * owner chooses one note before its text is shared. The titles listing is bounded and
+ * shares titles only, after the owner reviews the exact list. Bodies of unchosen notes
+ * never leave the phone.
+ */
+import {
+  NOTES_CAPABILITY,
+  type NotesResult,
+  type NotesTarget,
+  validateNotesOperation,
+  validateNotesResult,
+} from "./notes-contract.ts";
+
+export const NOTES_SEARCH_CAPABILITY = "notes.search.v1";
+export const NOTES_TITLES_LIMIT = 50;
+export type NotesSearchOperation = {
+  type: "notes_search";
+  query: { kind: "content"; text: string } | { kind: "titles"; limit: number };
+};
+export type NotesSearchResult =
+  | {
+      version: 1;
+      kind: "notes_search";
+      query: NotesSearchOperation["query"];
+      basis: "no-match";
+    }
+  | {
+      version: 1;
+      kind: "notes_search";
+      query: { kind: "content"; text: string };
+      basis: "content-match";
+      target: NotesTarget;
+      record: NotesResult;
+    }
+  | {
+      version: 1;
+      kind: "notes_search";
+      query: { kind: "titles"; limit: number };
+      basis: "titles-reviewed";
+      /** Most recently updated first; at most query.limit entries. */
+      titles: string[];
+      /** True when more saved notes exist than the reviewed listing shows. */
+      truncated: boolean;
+    };
+function obj(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw Error("Invalid Notes search");
+  return value as Record<string, unknown>;
+}
+function keys(value: Record<string, unknown>, expected: string[]) {
+  if (
+    Object.keys(value).length !== expected.length ||
+    expected.some((key) => !Object.hasOwn(value, key))
+  )
+    throw Error("Unexpected Notes search fields");
+}
+export function isNotesSearchOperation(
+  value: unknown,
+): value is NotesSearchOperation {
+  return (
+    !!value &&
+    typeof value === "object" &&
+    (value as { type?: unknown }).type === "notes_search"
+  );
+}
+export function notesSearchCapabilityAvailable(
+  capabilities?: readonly string[],
+): boolean {
+  return (
+    capabilities?.includes(NOTES_SEARCH_CAPABILITY) === true &&
+    capabilities.includes(NOTES_CAPABILITY)
+  );
+}
+function query(value: unknown): NotesSearchOperation["query"] {
+  const q = obj(value);
+  if (q.kind === "content") {
+    keys(q, ["kind", "text"]);
+    if (
+      typeof q.text !== "string" ||
+      !q.text.trim() ||
+      q.text.length > 256 ||
+      q.text.includes("\0")
+    )
+      throw Error("Notes content search text is required");
+    return { kind: "content", text: q.text };
+  }
+  if (q.kind === "titles") {
+    keys(q, ["kind", "limit"]);
+    if (
+      typeof q.limit !== "number" ||
+      !Number.isSafeInteger(q.limit) ||
+      q.limit < 1 ||
+      q.limit > NOTES_TITLES_LIMIT
+    )
+      throw Error(`Notes titles listing is limited to 1-${NOTES_TITLES_LIMIT}`);
+    return { kind: "titles", limit: q.limit };
+  }
+  throw Error("Unsupported Notes search");
+}
+export function validateNotesSearchOperation(
+  value: unknown,
+): NotesSearchOperation {
+  const v = obj(value);
+  keys(v, ["type", "query"]);
+  if (v.type !== "notes_search") throw Error("Invalid Notes search operation");
+  return { type: "notes_search", query: query(v.query) };
+}
+export function validateNotesSearchResult(
+  operation: NotesSearchOperation,
+  value: unknown,
+): NotesSearchResult {
+  const op = validateNotesSearchOperation(operation);
+  const v = obj(value);
+  const base = ["version", "kind", "query", "basis"];
+  keys(
+    v,
+    v.basis === "no-match"
+      ? base
+      : v.basis === "titles-reviewed"
+        ? [...base, "titles", "truncated"]
+        : [...base, "target", "record"],
+  );
+  if (v.version !== 1 || v.kind !== "notes_search")
+    throw Error("Invalid Notes search receipt");
+  if (JSON.stringify(query(v.query)) !== JSON.stringify(op.query))
+    throw Error("Notes search changed");
+  if (v.basis === "no-match")
+    return { version: 1, kind: "notes_search", query: op.query, basis: "no-match" };
+  if (op.query.kind === "titles") {
+    if (v.basis !== "titles-reviewed") throw Error("Notes listing proof changed");
+    if (
+      !Array.isArray(v.titles) ||
+      v.titles.length < 1 ||
+      v.titles.length > op.query.limit ||
+      typeof v.truncated !== "boolean" ||
+      v.titles.some(
+        (title) =>
+          typeof title !== "string" || title.length > 500 || title.includes("\0"),
+      )
+    )
+      throw Error("Invalid reviewed Notes titles");
+    return {
+      version: 1,
+      kind: "notes_search",
+      query: op.query,
+      basis: "titles-reviewed",
+      titles: [...(v.titles as string[])],
+      truncated: v.truncated,
+    };
+  }
+  if (v.basis !== "content-match") throw Error("Notes search proof changed");
+  const selected = validateNotesOperation({
+    type: "notes_read_selected",
+    target: v.target,
+  });
+  if (selected.type !== "notes_read_selected")
+    throw Error("Invalid selected Notes read");
+  return {
+    version: 1,
+    kind: "notes_search",
+    query: op.query,
+    basis: "content-match",
+    target: selected.target,
+    record: validateNotesResult(selected, v.record),
+  };
+}
