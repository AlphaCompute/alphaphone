index 0000000000000000000000000000000000000000..b7f9d81ba006bd5c05168e2007e12268bb26df63
--- /dev/null
+++ b/plugins/plugin-assistant/src/services/device-actions/foreground-review-contract.ts
@@ -0,0 +1,86 @@
+/**
+ * Device operations the phone resolves in a foreground local review before anything is
+ * shared or changed: free/busy reads, Notes search and name-targeted edits. Each family
+ * requires its own negotiated capability; a phone that lacks it never receives the
+ * operation in the tool schema or the proposal list.
+ */
+import {
+  CALENDAR_AVAILABILITY_CAPABILITY,
+  type CalendarAvailabilityOperation,
+  type CalendarAvailabilityResult,
+  isCalendarAvailabilityOperation,
+  validateCalendarAvailabilityOperation,
+  validateCalendarAvailabilityResult,
+} from "./calendar-availability-contract.ts";
+import {
+  isNamedTargetOperation,
+  type NamedTargetOperation,
+  type NamedTargetResult,
+  namedTargetCapabilityAvailable,
+  validateNamedTargetOperation,
+  validateNamedTargetResult,
+} from "./named-target-contract.ts";
+import {
+  isNotesSearchOperation,
+  type NotesSearchOperation,
+  type NotesSearchResult,
+  notesSearchCapabilityAvailable,
+  validateNotesSearchOperation,
+  validateNotesSearchResult,
+} from "./notes-search-contract.ts";
+
+export const FOREGROUND_REVIEW_TYPES = [
+  "calendar_availability",
+  "notes_search",
+  "notes_named",
+  "calendar_named",
+  "reminder_named",
+] as const;
+export type ForegroundReviewOperation =
+  | CalendarAvailabilityOperation
+  | NotesSearchOperation
+  | NamedTargetOperation;
+export type ForegroundReviewResult =
+  | CalendarAvailabilityResult
+  | NotesSearchResult
+  | NamedTargetResult;
+export function isForegroundReviewType(type: unknown): boolean {
+  return (FOREGROUND_REVIEW_TYPES as readonly unknown[]).includes(type);
+}
+export function isForegroundReviewOperation(
+  value: unknown,
+): value is ForegroundReviewOperation {
+  return (
+    !!value &&
+    typeof value === "object" &&
+    isForegroundReviewType((value as { type?: unknown }).type)
+  );
+}
+export function foregroundReviewCapabilityAvailable(
+  type: string,
+  capabilities?: readonly string[],
+): boolean {
+  if (type === "calendar_availability")
+    return capabilities?.includes(CALENDAR_AVAILABILITY_CAPABILITY) === true;
+  if (type === "notes_search") return notesSearchCapabilityAvailable(capabilities);
+  return namedTargetCapabilityAvailable(type, capabilities);
+}
+export function validateForegroundReviewOperation(
+  value: unknown,
+): ForegroundReviewOperation {
+  if (isCalendarAvailabilityOperation(value))
+    return validateCalendarAvailabilityOperation(value);
+  if (isNotesSearchOperation(value)) return validateNotesSearchOperation(value);
+  if (isNamedTargetOperation(value)) return validateNamedTargetOperation(value);
+  throw Error("Unsupported foreground review operation");
+}
+export function validateForegroundReviewResult(
+  operation: ForegroundReviewOperation,
+  value: unknown,
+): ForegroundReviewResult {
+  if (operation.type === "calendar_availability")
+    return validateCalendarAvailabilityResult(operation, value);
+  if (operation.type === "notes_search")
+    return validateNotesSearchResult(operation, value);
+  return validateNamedTargetResult(operation, value);
+}
diff --git a/plugins/plugin-assistant/src/services/device-actions/named-target-contract.ts b/plugins/plugin-assistant/src/services/device-actions/named-target-contract.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1017fb72454ce06ea10fc9df93400ae8428994c6
--- /dev/null
+++ b/plugins/plugin-assistant/src/services/device-actions/named-target-contract.ts
@@ -0,0 +1,246 @@
+/**
+ * Name-targeted edits and deletions requested from Home. The agent supplies only a
+ * name, never an identity or revision. The phone matches candidates locally, the owner
+ * chooses exactly one in a local disambiguation review, and the resulting exact-target
+ * operation is approved and executed under its existing selected-record contract.
+ * Candidates that were not chosen never leave the phone.
+ */
+import {
+  CALENDAR_CAPABILITY,
+  type CalendarFields,
+  type CalendarOperation,
+  type CalendarRecordResult,
+  calendarFields,
+  validateCalendarOperation,
+  validateCalendarResult,
+} from "./calendar-contract.ts";
+import {
+  NOTES_CAPABILITY,
+  type NotesFields,
+  type NotesOperation,
+  type NotesResult,
+  notesFields,
+  validateNotesOperation,
+  validateNotesResult,
+} from "./notes-contract.ts";
+import {
+  REMINDER_CAPABILITY,
+  type ReminderFields,
+  type ReminderOperation,
+  type ReminderResult,
+  reminderFields,
+  validateReminderOperation,
+  validateReminderResult,
+} from "./reminder-contract.ts";
+
+export const NAMED_TARGET_CAPABILITY = "device.named-target.v1";
+export type NamedTargetOperation =
+  | { type: "notes_named"; action: "update"; name: string; fields: NotesFields }
+  | { type: "notes_named"; action: "delete"; name: string }
+  | {
+      type: "calendar_named";
+      action: "update";
+      name: string;
+      fields: CalendarFields;
+    }
+  | { type: "calendar_named"; action: "delete"; name: string }
+  | {
+      type: "reminder_named";
+      action: "update";
+      name: string;
+      fields: ReminderFields;
+    }
+  | { type: "reminder_named"; action: "cancel"; name: string };
+export type NamedTargetExactOperation =
+  | NotesOperation
+  | CalendarOperation
+  | ReminderOperation;
+export type NamedTargetResult =
+  | {
+      version: 1;
+      kind: NamedTargetOperation["type"];
+      action: NamedTargetOperation["action"];
+      name: string;
+      basis: "no-match";
+    }
+  | {
+      version: 1;
+      kind: NamedTargetOperation["type"];
+      action: NamedTargetOperation["action"];
+      name: string;
+      /** The owner chose this record among local matches (possibly the only one). */
+      basis: "owner-chosen";
+      operation: NamedTargetExactOperation;
+      record: NotesResult | CalendarRecordResult | ReminderResult;
+    };
+const DOMAIN_CAPABILITY = {
+  notes_named: NOTES_CAPABILITY,
+  calendar_named: CALENDAR_CAPABILITY,
+  reminder_named: REMINDER_CAPABILITY,
+} as const;
+const ACTIONS = {
+  notes_named: ["update", "delete"],
+  calendar_named: ["update", "delete"],
+  reminder_named: ["update", "cancel"],
+} as const;
+function obj(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw Error("Invalid named target object");
+  return value as Record<string, unknown>;
+}
+function keys(value: Record<string, unknown>, expected: string[]) {
+  if (
+    Object.keys(value).length !== expected.length ||
+    expected.some((key) => !Object.hasOwn(value, key))
+  )
+    throw Error("Unexpected named target fields");
+}
+function name(value: unknown): string {
+  if (
+    typeof value !== "string" ||
+    !value.trim() ||
+    value.length > 256 ||
+    value.includes("\0")
+  )
+    throw Error("A record name is required");
+  return value;
+}
+export function isNamedTargetOperation(
+  value: unknown,
+): value is NamedTargetOperation {
+  return (
+    !!value &&
+    typeof value === "object" &&
+    Object.hasOwn(DOMAIN_CAPABILITY, String((value as { type?: unknown }).type))
+  );
+}
+/** Requires the named-target capability and the domain's selected-record capability. */
+export function namedTargetCapabilityAvailable(
+  type: string,
+  capabilities?: readonly string[],
+): boolean {
+  const domain = DOMAIN_CAPABILITY[type as keyof typeof DOMAIN_CAPABILITY];
+  return (
+    !!domain &&
+    capabilities?.includes(NAMED_TARGET_CAPABILITY) === true &&
+    capabilities.includes(domain)
+  );
+}
+/** Exact-target operation type the local review resolves to. */
+export function namedTargetExactType(
+  operation: NamedTargetOperation,
+): NamedTargetExactOperation["type"] {
+  if (operation.type === "notes_named")
+    return operation.action === "update" ? "notes_update" : "notes_delete";
+  if (operation.type === "calendar_named")
+    return operation.action === "update" ? "calendar_update" : "calendar_delete";
+  return operation.action === "update" ? "reminder_update" : "reminder_cancel";
+}
+export function validateNamedTargetOperation(
+  value: unknown,
+): NamedTargetOperation {
+  const v = obj(value);
+  if (!isNamedTargetOperation(v)) throw Error("Unsupported named target");
+  const allowed = ACTIONS[v.type] as readonly string[];
+  if (!allowed.includes(String(v.action)))
+    throw Error("Unsupported named target action");
+  if (v.action === "update") {
+    keys(v, ["type", "action", "name", "fields"]);
+    if (v.type === "notes_named")
+      return {
+        type: v.type,
+        action: "update",
+        name: name(v.name),
+        fields: notesFields(v.fields),
+      };
+    if (v.type === "calendar_named")
+      return {
+        type: v.type,
+        action: "update",
+        name: name(v.name),
+        fields: calendarFields(v.fields),
+      };
+    return {
+      type: "reminder_named",
+      action: "update",
+      name: name(v.name),
+      fields: reminderFields(v.fields),
+    };
+  }
+  keys(v, ["type", "action", "name"]);
+  if (v.type === "notes_named")
+    return { type: v.type, action: "delete", name: name(v.name) };
+  if (v.type === "calendar_named")
+    return { type: v.type, action: "delete", name: name(v.name) };
+  return { type: "reminder_named", action: "cancel", name: name(v.name) };
+}
+/**
+ * Builds and validates the exact selected-record operation for the record the owner
+ * chose. Fields come from the reviewed named proposal, never from the local match.
+ */
+export function resolveNamedTarget(
+  operation: NamedTargetOperation,
+  target: unknown,
+): NamedTargetExactOperation {
+  const op = validateNamedTargetOperation(operation);
+  const type = namedTargetExactType(op);
+  const exact = "fields" in op ? { type, target, fields: op.fields } : { type, target };
+  if (op.type === "notes_named") return validateNotesOperation(exact);
+  if (op.type === "calendar_named") return validateCalendarOperation(exact);
+  return validateReminderOperation(exact);
+}
+export function validateNamedTargetResult(
+  operation: NamedTargetOperation,
+  value: unknown,
+): NamedTargetResult {
+  const op = validateNamedTargetOperation(operation);
+  const v = obj(value);
+  const base = ["version", "kind", "action", "name", "basis"];
+  keys(v, v.basis === "no-match" ? base : [...base, "operation", "record"]);
+  if (
+    v.version !== 1 ||
+    v.kind !== op.type ||
+    v.action !== op.action ||
+    v.name !== op.name
+  )
+    throw Error("Named target result scope changed");
+  if (v.basis === "no-match")
+    return {
+      version: 1,
+      kind: op.type,
+      action: op.action,
+      name: op.name,
+      basis: "no-match",
+    };
+  if (v.basis !== "owner-chosen") throw Error("Named target proof changed");
+  const exact = obj(v.operation);
+  const resolved = resolveNamedTarget(op, exact.target);
+  if (JSON.stringify(canonical(resolved)) !== JSON.stringify(canonical(exact)))
+    throw Error("Named target operation changed");
+  const record =
+    op.type === "notes_named"
+      ? validateNotesResult(resolved as NotesOperation, v.record)
+      : op.type === "calendar_named"
+        ? validateCalendarResult(resolved as CalendarOperation, v.record)
+        : validateReminderResult(resolved as ReminderOperation, v.record);
+  if (!("eventId" in record) && !("noteId" in record) && !("reminderId" in record))
+    throw Error("Named target record changed");
+  return {
+    version: 1,
+    kind: op.type,
+    action: op.action,
+    name: op.name,
+    basis: "owner-chosen",
+    operation: resolved,
+    record: record as NotesResult | CalendarRecordResult | ReminderResult,
+  };
+}
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (!value || typeof value !== "object") return value;
+  return Object.fromEntries(
+    Object.keys(value)
+      .sort()
+      .map((key) => [key, canonical((value as Record<string, unknown>)[key])]),
+  );
+}
