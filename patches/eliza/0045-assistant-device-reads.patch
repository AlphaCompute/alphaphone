+  NAMED_TARGET_CAPABILITY,
+  namedTargetExactType,
+  resolveNamedTarget,
+  validateNamedTargetOperation,
+  validateNamedTargetResult,
+} from "./named-target-contract.ts";
+import {
+  NOTES_SEARCH_CAPABILITY,
+  validateNotesSearchOperation,
+  validateNotesSearchResult,
+} from "./notes-search-contract.ts";
+
+// Tuesday 2026-10-13, 15:00-16:00 America/New_York (EDT, UTC-4).
+const tuesday = {
+  type: "calendar_availability" as const,
+  start: "2026-10-13T19:00:00.000Z",
+  end: "2026-10-13T20:00:00.000Z",
+  timeZone: "America/New_York",
+};
+const timed = (
+  start: string,
+  end: string,
+  availability: "busy" | "free" | "tentative",
+) => ({ start, end, allDay: false, availability });
+
+test("availability operation is bounded and exact", () => {
+  expect(validateCalendarAvailabilityOperation(tuesday)).toEqual(tuesday);
+  for (const bad of [
+    { ...tuesday, end: tuesday.start },
+    { ...tuesday, end: "2026-10-21T19:00:00.000Z" },
+    { ...tuesday, start: "2026-10-13T19:00:00Z" },
+    { ...tuesday, timeZone: "Mars/Olympus" },
+    { ...tuesday, calendarIds: ["1"] },
+  ])
+    expect(() => validateCalendarAvailabilityOperation(bad)).toThrow();
+});
+
+test("transparent events are ignored and the owner is free at 3pm Tuesday", () => {
+  const result = calendarAvailability(tuesday, 2, [
+    timed("2026-10-13T18:30:00.000Z", "2026-10-13T19:30:00.000Z", "free"),
+    timed("2026-10-13T20:00:00.000Z", "2026-10-13T21:00:00.000Z", "busy"),
+    timed("2026-10-13T17:00:00.000Z", "2026-10-13T19:00:00.000Z", "busy"),
+  ]);
+  expect(result.status).toBe("free");
+  expect(result.busy).toEqual([]);
+  expect(result.transparentIgnored).toBe(1);
+  expect(result.calendarCount).toBe(2);
+});
+
+test("all-day events block the whole owner-local day; tentative counts as busy", () => {
+  // All-day rows are UTC-midnight civil bounds: 2026-10-13 .. 2026-10-14.
+  const allDay = {
+    start: "2026-10-13T00:00:00.000Z",
+    end: "2026-10-14T00:00:00.000Z",
+    allDay: true,
+    availability: "busy" as const,
+  };
+  const busy = calendarAvailability(tuesday, 1, [allDay]);
+  expect(busy.status).toBe("busy");
+  expect(busy.busy).toEqual([
+    { start: tuesday.start, end: tuesday.end, allDay: true, tentative: false },
+  ]);
+  // The previous civil day ends at local midnight 2026-10-13T04:00Z, before the window.
+  expect(
+    calendarAvailability(tuesday, 1, [
+      { ...allDay, start: "2026-10-12T00:00:00.000Z", end: "2026-10-13T00:00:00.000Z" },
+    ]).status,
+  ).toBe("free");
+  // A transparent all-day event (for example a holiday marker) never blocks.
+  expect(
+    calendarAvailability(tuesday, 1, [{ ...allDay, availability: "free" }]).status,
+  ).toBe("free");
+  const tentative = calendarAvailability(tuesday, 1, [
+    timed("2026-10-13T19:30:00.000Z", "2026-10-13T20:30:00.000Z", "tentative"),
+  ]);
+  expect(tentative.busy).toEqual([
+    {
+      start: "2026-10-13T19:30:00.000Z",
+      end: tuesday.end,
+      allDay: false,
+      tentative: true,
+    },
+  ]);
+});
+
+test("availability receipts cannot widen the window or contradict their status", () => {
+  const result = calendarAvailability(tuesday, 1, [
+    timed("2026-10-13T19:15:00.000Z", "2026-10-13T19:45:00.000Z", "busy"),
+  ]);
+  expect(validateCalendarAvailabilityResult(tuesday, result)).toEqual(result);
+  expect(() =>
+    validateCalendarAvailabilityResult(tuesday, { ...result, status: "free" }),
+  ).toThrow(/status/);
+  expect(() =>
+    validateCalendarAvailabilityResult(tuesday, {
+      ...result,
+      window: { ...result.window, end: "2026-10-13T21:00:00.000Z" },
+    }),
+  ).toThrow(/window/);
+  expect(() =>
+    validateCalendarAvailabilityResult(tuesday, {
+      ...result,
+      busy: [{ ...result.busy[0], end: "2026-10-13T20:30:00.000Z" }],
+    }),
+  ).toThrow(/outside/);
+  expect(() =>
+    validateCalendarAvailabilityResult(tuesday, {
+      ...result,
+      busy: [{ ...result.busy[0], title: "Private" }],
+    }),
+  ).toThrow();
+});
+
+const notesTarget = {
+  sourceId: "notes",
+  sourceRevision: "a".repeat(64),
+  noteId: "note-1",
+  revision: "b".repeat(64),
+};
+test("named targets carry only a name and resolve to an exact reviewed operation", () => {
+  const remove = validateNamedTargetOperation({
+    type: "notes_named",
+    action: "delete",
+    name: "Groceries",
+  });
+  expect(namedTargetExactType(remove)).toBe("notes_delete");
+  expect(resolveNamedTarget(remove, notesTarget)).toEqual({
+    type: "notes_delete",
+    target: notesTarget,
+  });
+  const update = validateNamedTargetOperation({
+    type: "notes_named",
+    action: "update",
+    name: "Groceries",
+    fields: { title: "Groceries", body: "Milk" },
+  });
+  expect(resolveNamedTarget(update, notesTarget)).toEqual({
+    type: "notes_update",
+    target: notesTarget,
+    fields: { title: "Groceries", body: "Milk" },
+  });
+  for (const bad of [
+    { type: "notes_named", action: "delete", name: "x", target: notesTarget },
+    { type: "notes_named", action: "cancel", name: "x" },
+    { type: "reminder_named", action: "delete", name: "x" },
+    { type: "calendar_named", action: "delete", name: " " },
+  ])
+    expect(() => validateNamedTargetOperation(bad)).toThrow();
+  const result = {
+    version: 1,
+    kind: "notes_named",
+    action: "delete",
+    name: "Groceries",
+    basis: "owner-chosen",
+    operation: { type: "notes_delete", target: notesTarget },
+    record: { version: 1, kind: "notes_delete", ...notesTarget, sourceRevision: undefined },
+  };
+  delete (result.record as Record<string, unknown>).sourceRevision;
+  expect(validateNamedTargetResult(remove, result).basis).toBe("owner-chosen");
+  expect(() =>
+    validateNamedTargetResult(remove, {
+      ...result,
+      operation: { type: "notes_update", target: notesTarget, fields: { title: "x", body: "" } },
+    }),
+  ).toThrow();
+  expect(() => validateNamedTargetResult(remove, { ...result, name: "Other" })).toThrow();
+  expect(
+    validateNamedTargetResult(remove, {
+      version: 1,
+      kind: "notes_named",
+      action: "delete",
+      name: "Groceries",
+      basis: "no-match",
+    }).basis,
+  ).toBe("no-match");
+});
+
+test("notes search shares one chosen note or a bounded reviewed titles list", () => {
+  const content = validateNotesSearchOperation({
+    type: "notes_search",
+    query: { kind: "content", text: "passport" },
+  });
+  const record = {
+    version: 1,
+    kind: "notes_read_selected",
+    sourceId: "notes",
+    noteId: "note-1",
+    revision: "b".repeat(64),
+    fields: { title: "Travel", body: "passport renewal" },
+  };
+  expect(
+    validateNotesSearchResult(content, {
+      version: 1,
+      kind: "notes_search",
+      query: content.query,
+      basis: "content-match",
+      target: notesTarget,
+      record,
+    }).basis,
+  ).toBe("content-match");
+  const titles = validateNotesSearchOperation({
+    type: "notes_search",
+    query: { kind: "titles", limit: 2 },
+  });
+  expect(
+    validateNotesSearchResult(titles, {
+      version: 1,
+      kind: "notes_search",
+      query: titles.query,
+      basis: "titles-reviewed",
+      titles: ["Travel", "Groceries"],
+      truncated: true,
+    }).titles,
+  ).toEqual(["Travel", "Groceries"]);
+  expect(() =>
+    validateNotesSearchResult(titles, {
+      version: 1,
+      kind: "notes_search",
+      query: titles.query,
+      basis: "titles-reviewed",
+      titles: ["a", "b", "c"],
+      truncated: false,
+    }),
+  ).toThrow();
+  expect(() =>
+    validateNotesSearchOperation({ type: "notes_search", query: { kind: "titles", limit: 51 } }),
+  ).toThrow();
+});
+
+test("device contract admits the new families only with negotiated capabilities", () => {
+  const base = ["notes.local-record.v1", "calendar.local-event.v1", "reminders.local-record.v1"];
+  expect(deviceOperationSupportedByCapabilities("calendar_availability", base)).toBe(false);
+  expect(
+    deviceOperationSupportedByCapabilities("calendar_availability", [
+      ...base,
+      CALENDAR_AVAILABILITY_CAPABILITY,
+    ]),
+  ).toBe(true);
+  expect(foregroundReviewCapabilityAvailable("notes_search", [NOTES_SEARCH_CAPABILITY])).toBe(false);
+  expect(
+    foregroundReviewCapabilityAvailable("notes_search", [...base, NOTES_SEARCH_CAPABILITY]),
+  ).toBe(true);
+  expect(
+    foregroundReviewCapabilityAvailable("calendar_named", [
+      NAMED_TARGET_CAPABILITY,
+      "notes.local-record.v1",
+    ]),
+  ).toBe(false);
+  expect(
+    foregroundReviewCapabilityAvailable("calendar_named", [...base, NAMED_TARGET_CAPABILITY]),
+  ).toBe(true);
+  expect(validateDeviceOperation(tuesday)).toEqual(tuesday);
+  expect(() => validateDeviceOperation({ ...tuesday, end: tuesday.start })).toThrow(
+    /Calendar availability/,
+  );
+  // Availability is a foreground chat read, not a workflow read: no binding required.
+  expect(
+    validateDevicePayload({
+      action: "device_action",
+      version: 1,
+      installationId: "device",
+      enrollmentId: "enrollment",
+      operation: tuesday,
+    }).operation,
+  ).toEqual(tuesday);
+  expect(
+    validateForegroundReviewResult(tuesday, calendarAvailability(tuesday, 1, [])).status,
+  ).toBe("free");
+});
diff --git a/plugins/plugin-assistant/src/services/device-actions/foreground-review-contract.ts b/plugins/plugin-assistant/src/services/device-actions/foreground-review-contract.ts
