+        )
+      )
+        return null;
+    return {
+      issuer,
+      jwksUrl,
+      audience,
+      algorithm: algorithm as "ES256" | "RS256",
+      agentId,
+      ownerId,
+      organizationId,
+    };
+  } catch {
+    return null;
+  }
+}
