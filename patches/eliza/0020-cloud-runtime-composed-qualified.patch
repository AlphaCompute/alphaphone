+            id: identityId,
+            kind: "owner",
+            displayName: "Cloud owner",
+            createdAt: Date.now(),
+            passwordHash: null,
+            cloudUserId: verified.ownerId,
+          });
+        } catch {
+          identity = await store.findIdentity(identityId);
+        }
+      }
