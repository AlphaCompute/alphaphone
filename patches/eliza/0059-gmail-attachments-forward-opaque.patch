+      },
+      crypto.randomUUID(),
+    ),
+  ).rejects.toThrow("unique");
+  const big = Buffer.alloc(3 * 1024 * 1024, 65);
+  await expect(
+    inbox.review(
+      owner,
+      {
+        ...compose,
+        attachments: [file("a.txt", "text/plain", big), file("b.txt", "text/plain", big)],
+      },
+      crypto.randomUUID(),
+    ),
+  ).rejects.toThrow("5 MiB in total");
+});
