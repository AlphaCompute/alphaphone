+import {test, expect} from 'bun:test';
+import {mkdtemp, cp, rm, rename, writeFile, readFile, realpath} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {checkWorkflowSource} from '../src/services/workflow-source-check';
+
+const valid = `import {createSmithers} from 'smthrs/create';import {z} from 'zod';
+const {Workflow,Task,smithers,outputs}=createSmithers({result:z.object({text:z.string()})},{dbPath:process.env.ELIZA_SMTHRS_DB_PATH});
+export default smithers(()=><Workflow name="synthetic"><Task id="result" output={outputs.result}>{()=>({text:'synthetic'})}</Task></Workflow>);`;
+
+test.skipIf(!process.env.ALPHA_WORKFLOW_WORKER_OUTPUT)('production checker uses packaged compiler, survives moves and fails closed', async()=>{
+ const temporary=await realpath(await mkdtemp(join(tmpdir(),'eliza-packaged-compiler-')));
+ const keys=['ELIZA_SMTHRS_RUNTIME_DIR','BUN_BIN','ELIZA_PLATFORM','AGENT_ROOT','LD_PATH','BUN_PATH','LD_LIBRARY_PATH'];
+ const before=Object.fromEntries(keys.map(key=>[key,process.env[key]]));
+ try{
+  const original=join(temporary,'original'),moved=join(temporary,'moved');
+  await cp(join(process.env.ALPHA_WORKFLOW_WORKER_OUTPUT!,'compiler'),join(original,'compiler'),{recursive:true});
+  const launches=join(temporary,'launches.txt'),wrapper=join(temporary,'bun-wrapper');
+  const quote=(value:string)=>"'"+value.replaceAll("'","'\"'\"'")+"'";
+  await writeFile(wrapper,'#!/bin/sh\npwd >> '+quote(launches)+'\nexec '+quote(process.execPath)+' "$@"\n',{mode:0o700});
+  process.env.BUN_BIN=wrapper;process.env.ELIZA_SMTHRS_RUNTIME_DIR=original;
+  expect(await checkWorkflowSource(valid)).toEqual([]);
+  expect((await readFile(launches,'utf8')).trim()).toBe(join(original,'compiler'));
+  expect(await checkWorkflowSource("import {CodexAgent} from 'smthrs';\n"+valid)).not.toEqual([]);
+  expect(await checkWorkflowSource("const wrong:number='no';\n"+valid)).not.toEqual([]);
+  expect(await checkWorkflowSource("throw new Error('DRAFT_EXECUTED');\n"+valid)).toEqual([]);
+  await rename(original,moved);process.env.ELIZA_SMTHRS_RUNTIME_DIR=moved;
+  expect(await checkWorkflowSource(valid)).toEqual([]);
+  expect((await readFile(launches,'utf8')).trim().split('\n').at(-1)).toBe(join(moved,'compiler'));
+  await rm(join(moved,'compiler/node_modules/typescript/lib/typescript.js'));
+  await expect(checkWorkflowSource(valid)).rejects.toThrow('Workflow compiler unavailable');
+  delete process.env.ELIZA_SMTHRS_RUNTIME_DIR;
+  expect(await checkWorkflowSource(valid)).toEqual([]);
+  expect(await checkWorkflowSource('export default 42;')).not.toEqual([]);
+  process.env.ELIZA_PLATFORM='android';process.env.AGENT_ROOT=temporary;
+  delete process.env.LD_PATH;delete process.env.BUN_PATH;delete process.env.LD_LIBRARY_PATH;
+  await expect(checkWorkflowSource(valid)).rejects.toThrow('Workflow compiler unavailable');
+ }finally{
+  for(const key of keys){if(before[key]===undefined)delete process.env[key];else process.env[key]=before[key];}
+  await rm(temporary,{recursive:true,force:true});
+ }
+},120000);
