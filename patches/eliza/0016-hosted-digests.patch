+/** Delivery state only. Existing embedded_executions remains execution authority. */
+export const hostedSources = workflowSchema.table(
+  'hosted_sources',
+  {
+    agentId: text('agent_id').notNull(),
+    ownerId: text('owner_id').notNull(),
+    id: text('id').notNull(),
