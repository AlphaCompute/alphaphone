+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+
+const plugin = fileURLToPath(new URL("../..", import.meta.url));
+const sources = path.join(plugin, "android/src/main/java/ai/eliza/plugins/browsersurface");
+const policy = ["BrowserWebOrigin.java", "BrowserDownloadPolicy.java", "BrowserSitePermissions.java"];
+const bin = (name) => (process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", name) : name);
+
+test("origins, download cookie scope, data: decoding, private history and site permissions", (t) => {
+  const classes = fs.mkdtempSync(path.join(os.tmpdir(), "browser-web-policy-"));
+  t.after(() => fs.rmSync(classes, { recursive: true, force: true }));
+  execFileSync(bin("javac"), ["-d", classes, ...policy.map((file) => path.join(sources, file)), path.join(plugin, "test/native-host/BrowserWebPolicyTest.java")], { timeout: 60000 });
+  const output = execFileSync(bin("java"), ["-cp", classes, "BrowserWebPolicyTest"], { timeout: 60000, encoding: "utf8" });
+  assert.match(output, /^\d+ assertions passed/);
+});
+
+test("the shared policy has no Android, logging or network dependencies", () => {
+  for (const file of policy) {
+    const source = fs.readFileSync(path.join(sources, file), "utf8");
+    assert.doesNotMatch(source, /^import android\./m, file);
+    assert.doesNotMatch(source, /System\.out|printStackTrace|java\.net\.(URL|HttpURLConnection|Socket)\b/, file);
+  }
+});
