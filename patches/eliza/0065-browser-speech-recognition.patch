+import { describe, expect, it } from "vitest";
+import { BrowserSpeechRecognizer } from "./speech-recognizer.ts";
+import { installSpeechWorker } from "./speech-worker.ts";
+import {
+  createTokenDecoder,
+  logMelSpectrogram,
+  melFilterBank,
+  noSpeechDecision,
+  repeatingTail,
+  silentRecording,
+  WHISPER,
+} from "./whisper-engine.ts";
+
+class ScriptedWorker {
+  posted: unknown[] = [];
+  terminated = false;
+  onmessage: ((event: MessageEvent) => void) | null = null;
+  onerror: ((event: ErrorEvent) => void) | null = null;
+  postMessage(message: unknown) { this.posted.push(message); }
+  terminate() { this.terminated = true; }
+  emit(data: unknown) { if (!this.terminated) this.onmessage?.({ data } as MessageEvent); }
+}
+function recognizer(idleMs = 50) {
+  const workers: ScriptedWorker[] = [];
+  const value = new BrowserSpeechRecognizer({
+    manifestUrl: () => "https://host.test/speech/manifest.json",
+    createWorker: () => { const worker = new ScriptedWorker(); workers.push(worker); return worker as unknown as Worker; },
+    idleMs,
+  });
+  return { value, workers };
+}
+const transcript = { text: "Hello there", noSpeech: false, engine: "whisper", model: "whisper-tiny.en", modelRevision: "r", runtime: "ort", language: "en" };
+
+describe("whisper engine", () => {
+  it("builds 80 Slaney mel filters over 201 bins and floors silence", () => {
+    const filters = melFilterBank();
+    expect(filters.length).toBe(WHISPER.mels * (WHISPER.nFft / 2 + 1));
+    expect(filters.every(Number.isFinite)).toBe(true);
+    const features = logMelSpectrogram(new Float32Array(16000));
+    expect(features.length).toBe(WHISPER.mels * WHISPER.frames);
+    expect(new Set(features).size).toBe(1);
+  });
+  it("reports silence before any model work and rejects filler no-speech text", () => {
+    expect(silentRecording(new Float32Array(16000))).toBe(true);
+    const tone = Float32Array.from({ length: 16000 }, (_, i) => 0.2 * Math.sin(i / 5));
+    expect(silentRecording(tone)).toBe(false);
+    expect(noSpeechDecision("[BLANK_AUDIO]", 0.1, -0.2)).toBe(true);
+    expect(noSpeechDecision("...", 0.1, -0.2)).toBe(true);
+    expect(noSpeechDecision("you", 0.9, -0.1)).toBe(true);
+    expect(noSpeechDecision("Call me at noon.", 0.1, -0.3)).toBe(false);
+  });
+  it("stops decoder loops and decodes byte-level tokens", () => {
+    expect(repeatingTail([1, 2, 1, 2, 1, 2, 1, 2])).toBe(2);
+    expect(repeatingTail([1, 2, 3, 4])).toBe(0);
+    const decode = createTokenDecoder({ Hello: 0, "Ġthere": 1 });
+    expect(decode([0, 1, WHISPER.eot])).toBe("Hello there");
+  });
+});
+
+describe("browser speech recognizer", () => {
+  it("uses the host manifest and worker, and keeps one request at a time", async () => {
+    const { value, workers } = recognizer();
+    const first = value.transcribe(new Float32Array(1600), new AbortController().signal);
+    expect(workers).toHaveLength(1);
+    const request = workers[0].posted[0] as { id: string; manifestUrl: string };
+    expect(request.manifestUrl).toBe("https://host.test/speech/manifest.json");
+    const second = value.transcribe(new Float32Array(1600), new AbortController().signal);
+    await expect(first).rejects.toMatchObject({ name: "AbortError" });
+    expect(workers[0].terminated).toBe(true);
+    const next = workers[1].posted[0] as { id: string };
+    workers[1].emit({ type: "result", id: next.id, ...transcript });
+    await expect(second).resolves.toMatchObject({ text: "Hello there" });
+  });
+  it("cancellation terminates the worker so a late result cannot arrive", async () => {
+    const { value, workers } = recognizer();
+    const controller = new AbortController();
+    const pending = value.transcribe(new Float32Array(1600), controller.signal);
+    controller.abort();
+    await expect(pending).rejects.toMatchObject({ name: "AbortError" });
+    expect(workers[0].terminated).toBe(true);
+  });
+  it("maps worker errors to recorder codes and releases an idle model", async () => {
+    const { value, workers } = recognizer(10);
+    const failed = value.transcribe(new Float32Array(1600), new AbortController().signal);
+    const id = (workers[0].posted[0] as { id: string }).id;
+    workers[0].emit({ type: "error", id, code: "model-load-failed", message: "missing" });
+    await expect(failed).rejects.toMatchObject({ code: "model-load-failed" });
+    const ok = value.transcribe(new Float32Array(1600), new AbortController().signal);
+    const next = (workers[1].posted[0] as { id: string }).id;
+    workers[1].emit({ type: "result", id: next, ...transcript });
+    await ok;
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    expect(workers[1].terminated).toBe(true);
+  });
+});
+
+describe("speech worker", () => {
+  it("refuses an unverified manifest without loading a model", async () => {
+    const messages: unknown[] = [];
+    let listener: ((event: MessageEvent) => void) | undefined;
+    const runtime = { env: { wasm: {} }, InferenceSession: { create: async () => { throw Error("must not load"); } }, Tensor: class {} } as never;
+    installSpeechWorker({ postMessage: (message) => messages.push(message), addEventListener: (_type, value) => { listener = value as never; } }, runtime,
+      (async () => new Response(JSON.stringify({ version: 2 }), { status: 200 })) as typeof fetch);
+    listener?.({ data: { type: "transcribe", id: "a", manifestUrl: "https://host.test/speech/manifest.json", samples: new Float32Array(1600) } } as MessageEvent);
+    await new Promise((resolve) => setTimeout(resolve, 10));
+    expect(messages).toEqual([{ type: "error", id: "a", code: "model-load-failed", message: "Unsupported speech model manifest" }]);
+  });
+});
