diff --git a/plugins/plugin-workflow/src/services/workflow-worker-termination.ts b/plugins/plugin-workflow/src/services/workflow-worker-termination.ts
new file mode 100644
--- /dev/null
+++ b/plugins/plugin-workflow/src/services/workflow-worker-termination.ts
@@ -0,0 +1,13 @@
+/** Fixed process metadata only; never serialize child output or arbitrary error context. */
+const SIGNALS = ['SIGHUP','SIGINT','SIGQUIT','SIGILL','SIGTRAP','SIGABRT','SIGBUS','SIGFPE','SIGKILL','SIGSEGV','SIGPIPE','SIGALRM','SIGTERM','SIGSYS','SIGXCPU','SIGXFSZ'] as const;
+export interface WorkerTerminationDiagnostic { exitCode: number | null; signal: string | null; }
+export function workerTermination(exitCode: unknown, signal: unknown): WorkerTerminationDiagnostic {
+ return {exitCode: Number.isInteger(exitCode) && Number(exitCode)>=0 && Number(exitCode)<=255 ? Number(exitCode) : null,
+  signal: signal === null || signal === undefined ? null : typeof signal==='string' && (SIGNALS as readonly string[]).includes(signal) ? signal : 'unrecognized'};
+}
+export function workerTerminationFromError(error: unknown): WorkerTerminationDiagnostic | undefined {
+ if(!error || typeof error!=='object' || !('code' in error) || error.code!=='SMTHRS_RESULT_MISSING' || !('context' in error))return;
+ const context=error.context;if(!context || typeof context!=='object' || !('workerTermination' in context))return;
+ const value=context.workerTermination;if(!value || typeof value!=='object' || !('exitCode' in value) || !('signal' in value))return;
+ return workerTermination(value.exitCode,value.signal);
+}
