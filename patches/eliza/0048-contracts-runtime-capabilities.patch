+++ b/packages/contracts/src/runtime-capabilities.test.ts
@@ -0,0 +1,121 @@
+import { describe, expect, it } from "vitest";
+import {
+  validateAgentResult,
+  validateRuntimeCapabilities,
+  validateScheduledOccurrence,
+  validateSpeechCapabilities,
+  validateUsageEvent,
+} from "./runtime-capabilities";
+
+const speech = {
+  version: 1,
+  stt: { location: "device", languages: ["en"] },
+  tts: { location: "none", languages: [] },
+};
+describe("runtime capability contracts", () => {
+  it("accepts a resident runtime with a plain HTTPS web UI and device capabilities", () => {
+    const value = {
+      version: 1,
+      runtime: "resident",
+      webUiUrl: "https://agent.example/app/",
+      inference: { provider: "cerebras", model: "qwen-3.8-27b" },
+      deviceCapabilities: [
+        "notes.local-record.v1",
+        "calendar.availability-read.v1",
+      ],
+      speech,
+    };
+    expect(validateRuntimeCapabilities(value)).toEqual(value);
+    expect(
+      validateRuntimeCapabilities({
+        version: 1,
+        runtime: "cloud",
+        deviceCapabilities: [],
+      }),
+    ).toEqual({ version: 1, runtime: "cloud", deviceCapabilities: [] });
+  });
+  it("rejects unknown versions, fields, credentials in URLs and duplicate capabilities", () => {
+    const base = { version: 1, runtime: "resident", deviceCapabilities: [] };
+    for (const bad of [
+      { ...base, version: 2 },
+      { ...base, extra: true },
+      { ...base, webUiUrl: "http://agent.example" },
+      { ...base, webUiUrl: "https://user:pass@agent.example" },
+      { ...base, webUiUrl: "https://agent.example/?token=secret" },
+      // URL parsing silently drops tabs and newlines, so control characters are refused first.
+      { ...base, webUiUrl: "https://agent.example/\napp/" },
+      { ...base, inference: { provider: "cerebras\t", model: "qwen-3.8-27b" } },
+      {
+        ...base,
+        deviceCapabilities: ["notes.local-record.v1", "notes.local-record.v1"],
+      },
+      { ...base, deviceCapabilities: ["Notes"] },
+      {
+        ...base,
+        inference: { provider: "cerebras", model: "qwen", apiKey: "x" },
+      },
+      { ...base, runtime: "enclave" },
+    ])
+      expect(() => validateRuntimeCapabilities(bad)).toThrow();
+  });
+  it("keeps speech location and languages consistent", () => {
+    expect(validateSpeechCapabilities(speech)).toEqual(speech);
+    expect(() =>
+      validateSpeechCapabilities({
+        ...speech,
+        tts: { location: "none", languages: ["en"] },
+      }),
+    ).toThrow();
+    expect(() =>
+      validateSpeechCapabilities({
+        ...speech,
+        stt: { location: "device", languages: [] },
+      }),
+    ).toThrow();
+  });
+  it("binds agent results to their scheduled occurrence", () => {
+    const occurrence = validateScheduledOccurrence({
+      version: 1,
+      workflowId: "digest",
+      occurrenceId: "occ-1",
+      scheduledAt: "2026-10-08T12:00:00.000Z",
+      status: "completed",
+    });
+    const result = {
+      version: 1,
+      occurrenceId: "occ-1",
+      status: "succeeded",
+      summary: "Done",
+      completedAt: "2026-10-08T12:00:05.000Z",
+    };
+    expect(validateAgentResult(occurrence, result)).toEqual(result);
+    expect(() =>
+      validateAgentResult(occurrence, { ...result, occurrenceId: "occ-2" }),
+    ).toThrow();
+    expect(() =>
+      validateAgentResult(occurrence, {
+        ...result,
+        completedAt: "2026-10-08T11:00:00.000Z",
+      }),
+    ).toThrow();
+  });
+  it("records usage observations without metering fields", () => {
+    const event = {
+      version: 1,
+      id: "u1",
+      at: "2026-10-08T12:00:00.000Z",
+      kind: "inference",
+      model: "qwen-3.8-27b",
+      units: { inputTokens: 10, outputTokens: 3 },
+    };
+    expect(validateUsageEvent(event)).toEqual(event);
+    expect(() => validateUsageEvent({ ...event, cost: 1 })).toThrow();
+    expect(() =>
+      validateUsageEvent({ ...event, units: { credits: 1 } }),
+    ).toThrow();
+    expect(() => validateUsageEvent({ ...event, units: {} })).toThrow();
+    expect(() =>
+      validateUsageEvent({ ...event, units: { inputTokens: 1.5 } }),
+    ).toThrow();
+  });
+});
