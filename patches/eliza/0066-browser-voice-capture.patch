index 0000000000000000000000000000000000000000..92ade5b5fa3a5bcd7df43c6c850fea6300e2f9aa
--- /dev/null
+++ b/packages/voice/src/browser-capture/browser-capture.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+import { BrowserAudioCapture } from "./audio-capture.ts";
+import { encodePcm16Wav } from "./recording-pcm.ts";
+
+class FakeTrack { stopped = false; stop() { this.stopped = true; } }
+class FakeStream { track = new FakeTrack(); getTracks() { return [this.track]; } }
+class FakeRecorder {
+  static instances: FakeRecorder[] = [];
+  static isTypeSupported(type: string) { return type === "audio/webm;codecs=opus"; }
+  state = "inactive"; mimeType = "audio/webm;codecs=opus";
+  ondataavailable: ((event: { data: Blob }) => void) | null = null;
+  onstop: (() => void) | null = null; onerror: (() => void) | null = null;
+  constructor() { FakeRecorder.instances.push(this); }
+  start() { this.state = "recording"; }
+  stop() { if (this.state === "inactive") return; this.state = "inactive"; this.ondataavailable?.({ data: new Blob([new Uint8Array(32)]) }); this.onstop?.(); }
+}
+(globalThis as { MediaRecorder?: unknown }).MediaRecorder = FakeRecorder;
+
+function capture(events: unknown[] = []) {
+  const closed: number[] = [];
+  const value = new BrowserAudioCapture({
+    openMicrophone: async () => ({ stream: new FakeStream() as unknown as MediaStream, close: () => closed.push(1) }),
+    stopped: (event) => events.push(event), hidden: () => false, maxDurationMs: 2000,
+  });
+  return { value, closed, events };
+}
+
+describe("PCM16 WAV", () => {
+  it("writes a mono 16-bit header and clips to the int16 range", () => {
+    const wav = encodePcm16Wav(Float32Array.from([0, 1, -1, 2, Number.NaN]), 16000);
+    const view = new DataView(wav.buffer);
+    expect(new TextDecoder().decode(wav.slice(0, 4))).toBe("RIFF");
+    expect(view.getUint16(22, true)).toBe(1);
+    expect(view.getUint32(24, true)).toBe(16000);
+    expect(view.getUint16(34, true)).toBe(16);
+    expect([0, 1, 2, 3, 4].map((i) => view.getInt16(44 + i * 2, true))).toEqual([0, 32767, -32768, 32767, 0]);
+    expect(() => encodePcm16Wav(new Float32Array(1), 4000)).toThrow();
+  });
+});
+
+describe("browser audio capture", () => {
+  it("stops a session into a retained clip and releases the microphone", async () => {
+    const { value, closed } = capture();
+    const started = await value.start();
+    expect(started.maxDurationMs).toBe(2000);
+    const clip = await value.stop();
+    expect(clip.recordingId).toBe(started.recordingId);
+    expect(value.get(clip.recordingId)?.blob.size).toBe(32);
+    expect(closed.length).toBeGreaterThan(0);
+  });
+  it("cancel retires the session; a replaced session cannot be stopped as the new one", async () => {
+    const { value } = capture();
+    const first = await value.start();
+    const second = await value.start();
+    expect(second.recordingId).not.toBe(first.recordingId);
+    const clip = await value.stop();
+    expect(clip.recordingId).toBe(second.recordingId);
+    expect(value.get(first.recordingId)).toBeUndefined();
+    await value.start(); value.cancel();
+    await expect(value.stop()).rejects.toThrow("Start a recording first.");
+  });
+  it("refuses durations beyond the host limit and background starts", async () => {
+    const { value } = capture();
+    await expect(value.start({ maxDurationMs: 5000 })).rejects.toThrow();
+    const hidden = new BrowserAudioCapture({ openMicrophone: async () => { throw Error("must not open"); }, stopped: () => {}, hidden: () => true });
+    await expect(hidden.start()).rejects.toMatchObject({ name: "AbortError" });
+  });
+});
