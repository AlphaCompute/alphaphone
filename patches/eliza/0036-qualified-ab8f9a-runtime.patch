+              (tool: { name?: string }) => tool.name === "HANDLE_RESPONSE",
+            )
+          )
+            throw new Error(
+              "Fixture supports Stage1 only; use the ordinary non-generative failure fallback",
+            );
+          if (!seed) calls.push({ messages: p.messages, tools: p.tools });
+          const quote =
+            scenario === "valid-quote"
+              ? original
