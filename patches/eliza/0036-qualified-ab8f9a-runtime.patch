+          enabled: false,
+          source: "explicit",
+          retentionDays: 30,
+        },
+      });
+
+      process.env.LLM_TRAJECTORY_CAPTURE = "sometimes";
+      const invalid = await consentsRoute.request(
+        "http://localhost/",
+        undefined,
+        WORKER_ENV,
+      );
+      expect(invalid.status).toBeGreaterThanOrEqual(500);
