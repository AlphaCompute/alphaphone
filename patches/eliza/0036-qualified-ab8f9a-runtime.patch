+    ).toHaveLength(1);
+    expect(model).not.toHaveBeenCalled();
+  } finally {
+    model.mockRestore();
+    await f.cleanup();
+  }
+}, 120000);
+
+it("quiet-blocked due work consumes its wake without a one-second retry loop", async () => {
