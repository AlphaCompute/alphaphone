+
+function widget(overrides: Partial<TaskChoiceWidget> = {}): TaskChoiceWidget {
+  return {
+    schemaVersion: 1,
+    taskId: "task-1",
+    epoch: 0,
+    contextKey: "a".repeat(64),
+    callbackData: `is1:${"b".repeat(32)}`,
+    expiresAt: new Date(Date.now() + 60000).toISOString(),
+    state: "pending",
+    block: {
+      kind: "choice",
+      id: "method",
+      scope: "task",
