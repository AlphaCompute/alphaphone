+  beforeAll(async () => {
+    expect(captureProtectedProfile().profile).toBe("dstack-cpu");
+    stateDir = await mkdtemp(path.join(tmpdir(), "eliza-session-protected-"));
+    adapter = createDatabaseAdapter(
+      { dataDir: path.join(stateDir, "db") },
+      randomUUID(),
+    );
