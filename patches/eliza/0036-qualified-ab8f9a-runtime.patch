+        '{"format":"eliza-account-export-v1"}',
+      );
+      const collected: Array<Record<string, unknown>> = [];
+      const route = createDataExportRoute({
+        collect: async (input) => {
+          collected.push(input);
+          return bytes;
+        },
+      });
+      const response = await postExport(route);
