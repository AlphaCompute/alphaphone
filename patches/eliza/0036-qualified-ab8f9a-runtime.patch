+  await act(async () => {
+    fireEvent.click(screen.getByRole("button"));
+  });
+  expect(calls).toBe(2);
+  expect(screen.queryByRole("alert")).toBeNull();
+});
+it("hides another task and never resubmits a committed choice", () => {
+  let calls = 0;
+  const view = render(
+    <TaskChoice
+      widget={widget()}
+      taskId="other"
+      onChoose={async () => {
+        calls++;
+      }}
