+function syncToCloud(rows: ReturnType<typeof observation>) {
+  return recordsFromSyncRequest({
+    agentId: "qa",
+    origin: "device_sync",
+    request: {
+      deviceId: "one",
+      deviceKind: "mac",
+      timezone: "UTC",
