+    reminderDeliveryLabel({
+      ...row,
+      latestAttempt: { outcome: "skipped_duplicate" },
+    } as never),
+  ).toBe("duplicate");
+});
+
+it("creates one in-app reminder through the existing definition API with retry identity", async () => {
+  const saved = vi.fn();
+  mocks.fetch.mockResolvedValue(
