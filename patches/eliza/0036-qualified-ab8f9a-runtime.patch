+      policyRevision: "policy",
+      state: "active",
+      decidedAt: new Date().toISOString(),
+      revokedAt: null,
+    },
+    allowedCapabilities: [capability],
+    allowedOrigins: ["https://example.test"],
+    now: Date.now(),
+  });
+  const protectedKinds: Array<string | undefined> = [];
