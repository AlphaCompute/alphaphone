+    ["GET", `/api/triggers/${trigger.id}`],
+    ["GET", `/api/triggers/${trigger.id}/runs`],
+    ["PUT", `/api/triggers/${trigger.id}`, { enabled: false }],
+    ["DELETE", `/api/triggers/${trigger.id}`],
