+  test(
+    "an oversized account is an explicit 413 EXPORT_TOO_LARGE, never a truncated export",
+    async () => {
+      const route = createDataExportRoute({
+        collect: async () => {
+          throw new AccountDeletionExportError(
+            "Account export requires a streamed support export",
+            "EXPORT_TOO_LARGE",
+          );
