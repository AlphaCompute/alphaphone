+beforeEach(() => {
+  mocks.fetch.mockReset();
+  mocks.fetch.mockImplementation(
+    async (_url, init) =>
+      new Response(
+        JSON.stringify(init.method === "GET" ? { reminders: [row] } : {}),
+        { status: 200, headers: { "content-type": "application/json" } },
