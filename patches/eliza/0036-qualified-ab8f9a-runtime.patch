+        granted: true,
+        policyVersion: "2026-09",
+        source: "api",
+      });
+      expect(typeof created.consent.recordedAt).toBe("string");
+
+      await postConsent({
+        purpose: "vision_capture",
+        granted: false,
+        policyVersion: "2026-09",
+      });
