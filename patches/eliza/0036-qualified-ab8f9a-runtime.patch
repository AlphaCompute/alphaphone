+		const build = createMainApiHeaderBuilder({
+			localAgentOrigins: [`http://127.0.0.1:${EMBEDDED_PORT}`],
+		});
+		expect(
+			build(`http://127.0.0.1:${EMBEDDED_PORT}/api/status`).Authorization,
+		).toBeUndefined();
+	});
+});
