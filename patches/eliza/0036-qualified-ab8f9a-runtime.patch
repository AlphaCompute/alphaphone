+  );
+  await waitFor(() =>
+    expect(
+      screen.getByRole("button", { name: "Cancel reminder" }),
+    ).toHaveProperty("disabled", false),
+  );
+  fireEvent.click(screen.getByRole("button", { name: "Cancel reminder" }));
