+  await f.actuator.showGuidance(
+    "task",
+    owner,
+    {
+      stepId: "step",
+      targetRef: `${observation.id}:0:0`,
+      text: "Continue here",
+    },
+    new AbortController().signal,
+  );
+  f.transition({ type: "pause" });
+  rejectHide = true;
+  await expect(f.actuator.quiesce({ owner, taskId: "task" })).rejects.toThrow(
+    /not acknowledged/,
