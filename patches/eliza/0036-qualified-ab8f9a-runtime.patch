+          ...(explicit ? { ownerSurface: "OWNER_TODOS" } : {}),
+        },
+        updatedAt: new Date(
+          Date.parse(record.definition.updatedAt) + 1,
+        ).toISOString(),
+      };
+      await service.repository.updateDefinition(definition, {
