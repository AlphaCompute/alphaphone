+const mocks = vi.hoisted(() => ({ fetch: vi.fn() }));
+vi.mock("../../api", () => ({
+  client: { getBaseUrl: () => "http://agent", rawRequest: mocks.fetch },
+}));
+const row = {
+  definition: {
+    id: "reminder-1",
+    title: "Call dentist",
+    description: "",
+    status: "active",
+    timezone: "UTC",
+    cadence: { kind: "once", dueAt: "2026-09-30T15:00:00Z" },
