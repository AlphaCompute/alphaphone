index 0000000..db46f1b
--- /dev/null
+++ w/plugins/plugin-assistant/src/services/device-actions/foreground-review-contract.test.ts
@@ -0,0 +1,208 @@
+import {
+  CALENDAR_AVAILABILITY_CAPABILITY,
+  calendarAvailability,
+  NAMED_TARGET_CAPABILITY,
+  NOTES_SEARCH_CAPABILITY,
+  resolveNamedTarget,
+} from "@elizaos/contracts";
+import { expect, test } from "vitest";
+import {
+  deviceOperationSupportedByCapabilities,
+  validateDeviceOperation,
+  validateDevicePayload,
+} from "./contract.ts";
+import {
+  foregroundReviewCapabilityAvailable,
+  namedTargetValidators,
+  validateForegroundReviewOperation,
+  validateForegroundReviewResult,
+} from "./foreground-review-contract.ts";
+
+const tuesday = {
+  type: "calendar_availability" as const,
+  start: "2026-10-13T19:00:00.000Z",
+  end: "2026-10-13T20:00:00.000Z",
+  timeZone: "America/New_York",
+};
+const notesTarget = {
+  sourceId: "notes",
+  sourceRevision: "a".repeat(64),
+  noteId: "note-1",
+  revision: "b".repeat(64),
+};
+const deleteRecord = {
+  version: 1,
+  kind: "notes_delete",
+  sourceId: "notes",
+  noteId: "note-1",
+  revision: "b".repeat(64),
+};
+
+test("named Notes targets resolve through the plugin's exact selected-record contract", () => {
+  const remove = validateForegroundReviewOperation({
+    type: "notes_named",
+    action: "delete",
+    name: "Groceries",
+  });
+  if (remove.type !== "notes_named") throw Error("expected named target");
+  expect(
+    resolveNamedTarget(remove, notesTarget, namedTargetValidators),
+  ).toEqual({
+    type: "notes_delete",
+    target: notesTarget,
+  });
+  // The exact Notes contract still rejects a malformed chosen record.
+  expect(() =>
+    resolveNamedTarget(
+      remove,
+      { ...notesTarget, revision: "short" },
+      namedTargetValidators,
+    ),
+  ).toThrow();
+  const result = {
+    version: 1,
+    kind: "notes_named",
+    action: "delete",
+    name: "Groceries",
+    basis: "owner-chosen",
+    operation: { type: "notes_delete", target: notesTarget },
+    record: deleteRecord,
+  };
+  expect(validateForegroundReviewResult(remove, result)).toEqual(result);
+  expect(() =>
+    validateForegroundReviewResult(remove, {
+      ...result,
+      operation: {
+        type: "notes_update",
+        target: notesTarget,
+        fields: { title: "Groceries", body: "" },
+      },
+    }),
+  ).toThrow();
+  expect(() =>
+    validateForegroundReviewResult(remove, {
+      ...result,
+      record: { ...deleteRecord, noteId: "note-2" },
+    }),
+  ).toThrow();
+  // Update fields use the Notes field contract.
+  expect(() =>
+    validateForegroundReviewOperation({
+      type: "notes_named",
+      action: "update",
+      name: "Groceries",
+      fields: { title: "Groceries", body: "Milk", extra: true },
+    }),
+  ).toThrow();
+});
+
+test("named Calendar and reminder targets bind domain fields", () => {
+  const update = validateForegroundReviewOperation({
+    type: "calendar_named",
+    action: "update",
+    name: "Dentist",
+    fields: {
+      title: "Dentist",
+      description: "",
+      location: "",
+      start: "2026-10-14T15:00:00.000Z",
+      end: "2026-10-14T16:00:00.000Z",
+      timeZone: "America/New_York",
+    },
+  });
+  expect(update.type).toBe("calendar_named");
+  expect(() =>
+    validateForegroundReviewOperation({
+      type: "calendar_named",
+      action: "update",
+      name: "Dentist",
+      fields: { title: "Dentist" },
+    }),
+  ).toThrow();
+  expect(
+    validateForegroundReviewOperation({
+      type: "reminder_named",
+      action: "cancel",
+      name: "Pills",
+    }),
+  ).toEqual({ type: "reminder_named", action: "cancel", name: "Pills" });
+});
+
+test("content search results carry only the chosen note's selected read", () => {
+  const search = validateForegroundReviewOperation({
+    type: "notes_search",
+    query: { kind: "content", text: "passport" },
+  });
+  const record = {
+    version: 1,
+    kind: "notes_read_selected",
+    sourceId: "notes",
+    noteId: "note-1",
+    revision: "b".repeat(64),
+    fields: { title: "Travel", body: "passport renewal" },
+  };
+  const result = {
+    version: 1,
+    kind: "notes_search",
+    query: { kind: "content", text: "passport" },
+    basis: "content-match",
+    target: notesTarget,
+    record,
+  };
+  expect(validateForegroundReviewResult(search, result)).toEqual(result);
+  expect(() =>
+    validateForegroundReviewResult(search, {
+      ...result,
+      record: { ...record, fields: { title: "Travel" } },
+    }),
+  ).toThrow();
+});
+
+test("device contract admits the new families only with negotiated capabilities", () => {
+  const base = [
+    "notes.local-record.v1",
+    "calendar.local-event.v1",
+    "reminders.local-record.v1",
+  ];
+  expect(
+    deviceOperationSupportedByCapabilities("calendar_availability", base),
+  ).toBe(false);
+  expect(
+    deviceOperationSupportedByCapabilities("calendar_availability", [
+      ...base,
+      CALENDAR_AVAILABILITY_CAPABILITY,
+    ]),
+  ).toBe(true);
+  expect(
+    foregroundReviewCapabilityAvailable("notes_search", [
+      ...base,
+      NOTES_SEARCH_CAPABILITY,
+    ]),
+  ).toBe(true);
+  expect(
+    deviceOperationSupportedByCapabilities("reminder_named", [
+      NAMED_TARGET_CAPABILITY,
+      "notes.local-record.v1",
+    ]),
+  ).toBe(false);
+  expect(validateDeviceOperation(tuesday)).toEqual(tuesday);
+  expect(() =>
+    validateDeviceOperation({ ...tuesday, end: tuesday.start }),
+  ).toThrow(/Calendar availability/);
+  // Availability is a foreground chat read, not a workflow read: no binding required.
+  expect(
+    validateDevicePayload({
+      action: "device_action",
+      version: 1,
+      installationId: "device",
+      enrollmentId: "enrollment",
+      operation: tuesday,
+    }).operation,
+  ).toEqual(tuesday);
+  expect(
+    validateForegroundReviewResult(
+      tuesday,
+      calendarAvailability(tuesday, 1, []),
+    ),
+  ).toMatchObject({ status: "free", busy: [] });
+});
