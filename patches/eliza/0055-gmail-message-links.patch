index 0000000000000000000000000000000000000000..88cf3e9d1aae2095bdd67598e3e944be2e7eccdb
--- /dev/null
+++ b/packages/cloud/shared/src/lib/utils/gmail-mime-text.test.ts
@@ -0,0 +1,53 @@
+import { expect, test } from "bun:test";
+import { extractGmailHtmlLinks, safeGmailLinkHref } from "./gmail-mime-text";
+
+const part = (mimeType: string, text: string) => ({
+  mimeType,
+  body: { data: Buffer.from(text).toString("base64url"), size: text.length },
+});
+
+test("HTML-only message: anchors become inert links with plain-text labels", () => {
+  const html = `<html><body><style>a{}</style><script>var a='<a href="https://script.invalid/">x</a>'</script>
+    <p>Read <a class="btn" href="https://docs.example.org/plan?a=1&amp;b=2">the <b>plan</b></a>.</p>
+    <a href='https://docs.example.org/plan?a=1&amp;b=2'>duplicate</a>
+    <a href=https://unquoted.example.org/x>Unquoted</a>
+    <a href="javascript:alert(1)">bad</a><a href="https://user:pw@example.org/">creds</a>
+    <a href="mailto:someone@example.org">mail</a><a href="/relative">relative</a>
+    <!-- <a href="https://comment.invalid/">hidden</a> -->
+    <a href="http://plain.example.org/">  </a></body></html>`;
+  const links = extractGmailHtmlLinks({
+    mimeType: "text/html",
+    body: part("text/html", html).body,
+  });
+  expect(links).toEqual([
+    { href: "https://docs.example.org/plan?a=1&b=2", text: "the plan" },
+    { href: "https://unquoted.example.org/x", text: "Unquoted" },
+    { href: "http://plain.example.org/", text: "plain.example.org" },
+  ]);
+});
+
+test("multipart/alternative: links come only from the HTML part; plain text yields none", () => {
+  const payload = {
+    mimeType: "multipart/alternative",
+    parts: [
+      part("text/plain", "Visit https://plain-only.example.org/ for details"),
+      part("text/html", '<p>Visit <a href="https://html.example.org/">our site</a></p>'),
+    ],
+  };
+  expect(extractGmailHtmlLinks(payload)).toEqual([
+    { href: "https://html.example.org/", text: "our site" },
+  ]);
+  expect(extractGmailHtmlLinks(part("text/plain", "https://plain-only.example.org/"))).toEqual([]);
+  expect(extractGmailHtmlLinks(null)).toEqual([]);
+});
+
+test("bounded: at most 50 links and long or malformed hrefs are dropped", () => {
+  const many = Array.from(
+    { length: 80 },
+    (_, i) => `<a href="https://e.example.org/${i}">${i}</a>`,
+  ).join("");
+  expect(extractGmailHtmlLinks(part("text/html", many))).toHaveLength(50);
+  expect(safeGmailLinkHref(`https://example.org/${"a".repeat(2100)}`)).toBeNull();
+  expect(safeGmailLinkHref("https://")).toBeNull();
+  expect(safeGmailLinkHref("data:text/html,x")).toBeNull();
+});
diff --git a/packages/cloud/shared/src/lib/utils/gmail-mime-text.ts b/packages/cloud/shared/src/lib/utils/gmail-mime-text.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4488ecd41d721f0ec8799ea5f2d741ac253c2f9b
--- /dev/null
+++ b/packages/cloud/shared/src/lib/utils/gmail-mime-text.ts
@@ -0,0 +1,116 @@
+// Pure helpers for Gmail API message payloads (users.messages.get format=full). No network,
+// no HTML rendering: links are returned as inert data for clients to review before opening.
+
+export interface GmailPayloadPart {
+  mimeType?: string;
+  filename?: string;
+  headers?: Array<{ name?: string; value?: string }>;
+  body?: { data?: string; size?: number; attachmentId?: string };
+  parts?: GmailPayloadPart[];
+}
+
+export interface GmailMessageLink {
+  href: string;
+  text: string;
+}
+
+const MAX_PARTS = 200;
+export const MAX_GMAIL_LINKS = 50;
+
+/** Decodes a Gmail part body (base64url) as UTF-8. */
+export function decodeGmailPartData(data: string): string {
+  return new TextDecoder("utf-8").decode(Buffer.from(data, "base64url"));
+}
+
+function walk(payload: GmailPayloadPart, visit: (part: GmailPayloadPart) => void): void {
+  let visited = 0;
+  const step = (part: GmailPayloadPart) => {
+    if (++visited > MAX_PARTS || !part || typeof part !== "object") return;
+    visit(part);
+    if (Array.isArray(part.parts)) for (const child of part.parts) step(child);
+  };
+  step(payload);
+}
+
+const entities: Record<string, string> = {
+  amp: "&",
+  lt: "<",
+  gt: ">",
+  quot: '"',
+  apos: "'",
+  nbsp: " ",
+  "#39": "'",
+};
+function decodeEntities(value: string): string {
+  return value.replace(/&(#x[0-9a-f]{1,6}|#[0-9]{1,7}|[a-z0-9]{2,8});/gi, (match, name: string) => {
+    const lower = name.toLowerCase();
+    if (lower.startsWith("#x")) {
+      const code = Number.parseInt(lower.slice(2), 16);
+      return code > 0 && code <= 0x10ffff ? String.fromCodePoint(code) : match;
+    }
+    if (lower.startsWith("#")) {
+      const code = Number.parseInt(lower.slice(1), 10);
+      return code > 0 && code <= 0x10ffff ? String.fromCodePoint(code) : match;
+    }
+    return entities[lower] ?? match;
+  });
+}
+
+/** Absolute http(s) URL without credentials, or null. */
+export function safeGmailLinkHref(value: string): string | null {
+  const candidate = decodeEntities(value.trim());
+  if (!candidate || candidate.length > 2048) return null;
+  let url: URL;
+  try {
+    url = new URL(candidate);
+  } catch {
+    return null;
+  }
+  if (
+    (url.protocol !== "https:" && url.protocol !== "http:") ||
+    url.username ||
+    url.password ||
+    !url.hostname
+  )
+    return null;
+  return url.href;
+}
+
+function linkText(html: string): string {
+  return decodeEntities(html.replace(/<[^>]*>/g, " "))
+    .replace(/[\u0000-\u001f\u007f]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, 200);
+}
+
+/**
+ * Anchors (`<a href>`) from the message's text/html parts, in document order, deduplicated by
+ * destination. Only absolute http(s) links without embedded credentials are returned; the anchor
+ * text is reduced to plain text so clients can show both what the email says and where it goes.
+ */
+export function extractGmailHtmlLinks(
+  payload: GmailPayloadPart | null | undefined,
+  decode: (part: GmailPayloadPart) => string = (part) => decodeGmailPartData(part.body?.data ?? ""),
+): GmailMessageLink[] {
+  if (!payload) return [];
+  const links: GmailMessageLink[] = [];
+  const seen = new Set<string>();
+  walk(payload, (part) => {
+    if (links.length >= MAX_GMAIL_LINKS) return;
+    if (part.mimeType?.toLowerCase() !== "text/html" || typeof part.body?.data !== "string") return;
+    const html = decode(part)
+      .replace(/<!--[\s\S]*?-->/g, " ")
+      .replace(/<(script|style)\b[\s\S]*?<\/\1\s*>/gi, " ");
+    for (const match of html.matchAll(/<a\b([^>]*)>([\s\S]*?)<\/a\s*>/gi)) {
+      if (links.length >= MAX_GMAIL_LINKS) break;
+      const attribute = /\bhref\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+))/i.exec(match[1] ?? "");
+      if (!attribute) continue;
+      const href = safeGmailLinkHref(attribute[1] ?? attribute[2] ?? attribute[3] ?? "");
+      if (!href || seen.has(href)) continue;
+      seen.add(href);
+      links.push({ href, text: linkText(match[2] ?? "") || new URL(href).hostname });
+    }
+  });
+  return links;
+}
