+package ai.eliza.plugins.passwords;
+
+import ai.eliza.plugins.securestore.nativeonly.PasswordFacets;
+import ai.eliza.plugins.securestore.nativeonly.PasswordVaultStore;
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.net.Uri;
+import androidx.activity.result.ActivityResult;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.ActivityCallback;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * Vault export and import, entirely native. Export needs a fresh device authentication (even
+ * when the vault is already unlocked) and an explicit confirmation, then writes CSV only to a
+ * document the user picks through the Storage Access Framework. Import reads a user-picked
+ * CSV, shows the exact HTTPS origin every row will be bound to, and adds rows only after
+ * confirmation; existing passwords are never overwritten. Results carry counts only: no
+ * method resolves with a password, username, label, address or file content.
+ */
+@CapacitorPlugin(name = "ElizaPasswordTransfer")
+public class PasswordTransferPlugin extends Plugin {
+  private static final int REVIEW_ORIGINS = 40;
+  private final ExecutorService io = Executors.newSingleThreadExecutor();
+  private PasswordCsv.Import pendingImport;
+
+  private PasswordVaultAccess access(PluginCall call) {
+    try { return PasswordVaultAccess.get(getContext()); }
+    catch (Exception unavailable) { call.reject("Saved passwords are unavailable", "unavailable"); return null; }
+  }
+
+  private void fail(PluginCall call, Exception failure) {
+    if (failure instanceof PasswordVaultAccess.Locked) call.reject("Unlock saved passwords first", "locked");
+    else if (failure instanceof PasswordVaultAccess.KeyInvalidated) call.reject("Saved passwords can no longer be decrypted on this device", "key-invalidated");
+    else call.reject("Saved passwords are unavailable", "unavailable");
+  }
+
+  /** A fresh device authentication, regardless of the current unlock window. */
+  private void authenticate(PluginCall call, PasswordVaultAccess access, Runnable next) {
+    Activity activity = getActivity();
+    if (activity == null) { call.reject("Saved passwords are unavailable", "unavailable"); return; }
+    activity.runOnUiThread(() -> {
+      access.lock();
+      SecretSurfaces.dismiss();
+      PasswordUnlock.prompt(activity, new PasswordUnlock.Result() {
+        @Override public void unlocked() { next.run(); }
+        @Override public void failed(String code) { call.reject("cancelled".equals(code) ? "Export was cancelled" : "no-screen-lock".equals(code) ? "Set a screen lock to use saved passwords" : "Unlock is unavailable", code); }
+      });
+    });
+  }
+
+  @PluginMethod public void exportVault(PluginCall call) {
+    PasswordVaultAccess access = access(call); if (access == null) return;
+    authenticate(call, access, () -> {
+      int count;
+      try { count = access.use(store -> { int rows = 0; JSONArray entries = store.entries(); for (int i = 0; i < entries.length(); i++) rows += PasswordVaultStore.bindings(entries.getJSONObject(i)).size(); return rows; }); }
+      catch (Exception failure) { fail(call, failure); return; }
+      if (count == 0) { call.reject("There are no saved passwords to export", "empty"); return; }
+      new AlertDialog.Builder(getActivity())
+        .setTitle("Export saved passwords?")
+        .setMessage("This creates a file with " + count + (count == 1 ? " password" : " passwords") + " that is NOT encrypted. Anyone who can open the file can read every password in it.\n\nSave it only somewhere you trust, and delete it when you are done.")
+        .setNegativeButton("Cancel", (dialog, which) -> call.reject("Export was cancelled", "cancelled"))
+        .setOnCancelListener(dialog -> call.reject("Export was cancelled", "cancelled"))
+        .setPositiveButton("Export", (dialog, which) -> {
+          Intent create = new Intent(Intent.ACTION_CREATE_DOCUMENT).addCategory(Intent.CATEGORY_OPENABLE).setType("text/csv").putExtra(Intent.EXTRA_TITLE, "passwords.csv");
+          try { startActivityForResult(call, create, "exportDocument"); }
+          catch (RuntimeException unavailable) { call.reject("No app can save the file", "unavailable"); }
+        })
+        .show();
+    });
+  }
+
+  @ActivityCallback private void exportDocument(PluginCall call, ActivityResult result) {
+    if (call == null) return;
+    Uri target = result.getResultCode() == Activity.RESULT_OK && result.getData() != null ? result.getData().getData() : null;
+    if (target == null) { call.reject("Export was cancelled", "cancelled"); return; }
+    PasswordVaultAccess access = access(call); if (access == null) return;
+    io.execute(() -> {
+      byte[] bytes = null;
+      try {
+        List<PasswordCsv.Entry> rows = access.use(store -> {
+          List<PasswordCsv.Entry> out = new ArrayList<>();
+          JSONArray entries = store.entries();
+          for (int i = 0; i < entries.length(); i++) {
+            JSONObject summary = entries.getJSONObject(i);
+            JSONObject record = store.get(summary.getString("id"));
+            out.add(new PasswordCsv.Entry(summary.getString("label"), summary.getString("username"), PasswordVaultStore.bindings(record), record.getString("password")));
+          }
+          return out;
+        });
+        int count = 0; for (PasswordCsv.Entry entry : rows) count += entry.facets.size();
+        bytes = PasswordCsv.export(rows);
+        rows.clear();
+        try (OutputStream out = getContext().getContentResolver().openOutputStream(target, "wt")) {
+          if (out == null) throw new java.io.IOException();
+          out.write(bytes);
+        }
+        JSObject done = new JSObject(); done.put("exported", count); call.resolve(done);
+      } catch (Exception failure) {
+        if (failure instanceof PasswordVaultAccess.Locked || failure instanceof PasswordVaultAccess.KeyInvalidated) fail(call, failure);
+        else call.reject("The file could not be written", "write-failed");
+      } finally { if (bytes != null) java.util.Arrays.fill(bytes, (byte) 0); }
+    });
+  }
+
+  @PluginMethod public void importVault(PluginCall call) {
+    PasswordVaultAccess access = access(call); if (access == null) return;
+    if (!access.unlocked()) { call.reject("Unlock saved passwords first", "locked"); return; }
+    Intent open = new Intent(Intent.ACTION_OPEN_DOCUMENT).addCategory(Intent.CATEGORY_OPENABLE).setType("*/*")
+      .putExtra(Intent.EXTRA_MIME_TYPES, new String[] {"text/csv", "text/comma-separated-values", "text/plain", "application/vnd.ms-excel"});
+    try { startActivityForResult(call, open, "importDocument"); }
+    catch (RuntimeException unavailable) { call.reject("No app can open a file", "unavailable"); }
+  }
+
+  @ActivityCallback private void importDocument(PluginCall call, ActivityResult result) {
+    if (call == null) return;
+    Uri source = result.getResultCode() == Activity.RESULT_OK && result.getData() != null ? result.getData().getData() : null;
+    if (source == null) { call.reject("Import was cancelled", "cancelled"); return; }
+    PasswordVaultAccess access = access(call); if (access == null) return;
+    io.execute(() -> {
+      byte[] bytes = null;
+      try {
+        try (InputStream in = getContext().getContentResolver().openInputStream(source); ByteArrayOutputStream buffer = new ByteArrayOutputStream()) {
+          if (in == null) throw new java.io.IOException();
+          byte[] chunk = new byte[65536]; int count;
+          while ((count = in.read(chunk)) != -1) { if (buffer.size() + count > PasswordCsv.MAX_BYTES) throw new SizeLimit(); buffer.write(chunk, 0, count); }
+          bytes = buffer.toByteArray();
+        }
+        Set<String> existing = access.use(store -> {
+          Set<String> keys = new HashSet<>(); JSONArray entries = store.entries();
+          for (int i = 0; i < entries.length(); i++) { JSONObject entry = entries.getJSONObject(i); for (String facet : PasswordVaultStore.bindings(entry)) if (PasswordFacets.isWeb(facet)) keys.add(facet + "\n" + entry.getString("username")); }
+          return keys;
+        });
+        PasswordCsv.Import parsed;
+        try { parsed = PasswordCsv.parse(bytes, existing); }
+        catch (java.io.IOException invalid) { call.reject(safeImportMessage(invalid.getMessage()), "invalid"); return; }
+        getActivity().runOnUiThread(() -> review(call, access, parsed));
+      } catch (SizeLimit large) { call.reject("The file is larger than 2 MB", "invalid"); }
+      catch (Exception failure) {
+        if (failure instanceof PasswordVaultAccess.Locked || failure instanceof PasswordVaultAccess.KeyInvalidated) fail(call, failure);
+        else call.reject("The file could not be read", "read-failed");
+      } finally { if (bytes != null) java.util.Arrays.fill(bytes, (byte) 0); }
+    });
+  }
+
+  private static final class SizeLimit extends Exception { SizeLimit() { super(null, null, false, false); } }
+
+  /** Parser messages are fixed strings; anything else is generic. */
+  private static String safeImportMessage(String message) {
+    List<String> known = java.util.Arrays.asList("The file is empty", "The file is larger than 2 MB", "The file is not UTF-8 text", "The file is not valid CSV",
+      "The file has too many rows", "The file has no url and password columns");
+    return known.contains(message) ? message : "The file could not be read";
+  }
+
+  private void review(PluginCall call, PasswordVaultAccess access, PasswordCsv.Import parsed) {
+    if (pendingImport != null) pendingImport.wipe();
+    pendingImport = parsed;
+    List<PasswordCsv.Row> rows = parsed.importable();
+    if (rows.isEmpty()) {
+      JSObject none = new JSObject(); none.put("imported", 0); none.put("skipped", parsed.skipped());
+      new AlertDialog.Builder(getActivity()).setTitle("Nothing to import").setMessage(PasswordCsv.review(parsed, REVIEW_ORIGINS)).setPositiveButton("Close", null).show();
+      parsed.wipe(); pendingImport = null; call.resolve(none); return;
+    }
+    boolean[] answered = {false};
+    new AlertDialog.Builder(getActivity())
+      .setTitle("Import passwords?")
+      .setMessage(PasswordCsv.review(parsed, REVIEW_ORIGINS) + "\n\nThe file itself is not encrypted. Delete it after importing.")
+      .setNegativeButton("Cancel", null)
+      .setPositiveButton("Import", (dialog, which) -> { answered[0] = true; commit(call, access, parsed); })
+      .setOnDismissListener(dialog -> { if (!answered[0]) { parsed.wipe(); if (pendingImport == parsed) pendingImport = null; call.reject("Import was cancelled", "cancelled"); } })
+      .show();
+  }
+
+  private void commit(PluginCall call, PasswordVaultAccess access, PasswordCsv.Import parsed) {
+    io.execute(() -> {
+      try {
+        int saved = access.use(store -> {
+          int count = 0;
+          for (PasswordCsv.Row row : parsed.importable()) {
+            List<String> facets = new ArrayList<>(); facets.add(row.origin);
+            String secret = row.password();
+            try { store.saveEntry(null, row.label, row.username, facets, secret); count++; }
+            catch (java.io.IOException full) { if ("Password vault is full".equals(full.getMessage())) break; }
+            finally { row.wipe(); }
+          }
+          return count;
+        });
+        JSObject done = new JSObject(); done.put("imported", saved); done.put("skipped", parsed.rows.size() - saved); call.resolve(done);
+      } catch (Exception failure) { fail(call, failure); }
+      finally { parsed.wipe(); if (pendingImport == parsed) pendingImport = null; }
+    });
+  }
+
+  @Override protected void handleOnDestroy() {
+    if (pendingImport != null) pendingImport.wipe();
+    pendingImport = null;
+    io.shutdown();
+    super.handleOnDestroy();
+  }
+}
