+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+
+const plugin = fileURLToPath(new URL("../..", import.meta.url));
+const sources = path.join(plugin, "android/src/main/java/ai/eliza/plugins/browsersurface");
+const policy = ["BrowserSessionPolicy.java"];
+const bin = (name) => (process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", name) : name);
+
+test("persistent-only tabs and history, bounded restore, site clearing and bookmarks", (t) => {
+  const classes = fs.mkdtempSync(path.join(os.tmpdir(), "browser-session-policy-"));
+  t.after(() => fs.rmSync(classes, { recursive: true, force: true }));
+  execFileSync(bin("javac"), ["-d", classes, ...policy.map((file) => path.join(sources, file)), path.join(plugin, "test/native-host/BrowserSessionPolicyTest.java")], { timeout: 60000 });
+  const output = execFileSync(bin("java"), ["-cp", classes, "BrowserSessionPolicyTest"], { timeout: 60000, encoding: "utf8" });
+  assert.match(output, /^\d+ assertions passed/);
+});
+
+test("the session policy has no Android, logging or network dependencies", () => {
+  for (const file of policy) {
+    const source = fs.readFileSync(path.join(sources, file), "utf8");
+    assert.doesNotMatch(source, /^import android\./m, file);
+    assert.doesNotMatch(source, /System\.out|printStackTrace|java\.net\.(URL|HttpURLConnection|Socket)\b/, file);
+  }
+});
