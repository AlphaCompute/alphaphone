+/** First header value (any count), for display of a provider draft. */
+function draftHeader(payload: Record<string, unknown>, name: string): string | null {
+  const headers = payload.headers;
+  if (!Array.isArray(headers)) return null;
+  const row = headers
+    .map((value) => object(value))
+    .find(
+      (value) => typeof value.name === "string" && value.name.toLowerCase() === name.toLowerCase(),
+    );
+  return row && typeof row.value === "string"
+    ? text(row.value.replace(/[\r\n]+/g, " "), 4096)
+    : null;
+}
+/** Literal addresses from a recipient header (display names dropped), at most 50. */
+function headerAddresses(value: string | null): string[] {
+  if (!value) return [];
+  const found = [
+    ...value.matchAll(/<([^<>\s@]+@[^<>\s@]+)>|(?:^|[\s,;])([^\s,;<>"@]+@[^\s,;<>"@]+)/g),
+  ].map((match) => (match[1] ?? match[2] ?? "").trim());
+  return [...new Set(found.filter(Boolean))].slice(0, 50);
+}
+function findPart(payload: GmailPayloadPart, mimeType: string): GmailPayloadPart | null {
+  let visited = 0;
+  const visit = (part: GmailPayloadPart): GmailPayloadPart | null => {
+    if (++visited > 200 || !part) return null;
+    if (
+      part.mimeType?.toLowerCase() === mimeType &&
+      !part.filename &&
+      typeof part.body?.data === "string"
+    )
+      return part;
+    for (const child of Array.isArray(part.parts) ? part.parts : []) {
+      const found = visit(child);
+      if (found) return found;
+    }
+    return null;
+  };
+  return visit(payload);
+}
