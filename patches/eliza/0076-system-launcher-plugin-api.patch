+            SystemLauncherApps.launchIntent(context, call.getString("packageName"))
+        } catch (error: IllegalArgumentException) {
+            call.reject("Choose an installed app")
+            return
+        }
+        if (intent == null) {
+            call.reject("App is unavailable")
+            return
+        }
+        startHandoff(call, intent)
+    }
