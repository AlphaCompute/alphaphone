+import {test, expect} from 'bun:test';
+import {mkdtemp, mkdir, readlink, rm, writeFile, readFile} from 'node:fs/promises';
+import {join} from 'node:path';
+import {tmpdir} from 'node:os';
+import {linkSmithersDependency, smithersProcessConfig, smithersStateRoot} from '../src/services/smithers-process';
+
+test('Android uses native loader arguments and only the reviewed environment', () => {
+ const env={ELIZA_PLATFORM:'android',AGENT_ROOT:'/app/assets',LD_PATH:'/apk/lib/loader',BUN_PATH:'/apk/lib/bun',
+  LD_LIBRARY_PATH:'/apk/lib:/app/abi',ELIZA_STATE_DIR:'/app/state',PATH:'/bin',
+  BUN_FEATURE_FLAG_DISABLE_IO_POOL:'1',CEREBRAS_API_KEY:'must-not-forward',ELIZA_API_TOKEN:'must-not-forward'};
+ const config=smithersProcessConfig('/source/plugin',env,'/wrong/bun',true);
+ expect(config.command).toBe('/apk/lib/loader');expect(config.prefix).toEqual(['/apk/lib/bun']);
+ expect(config.cwd).toBe('/app/assets/workflow-worker');expect(config.packaged).toBe(true);
+ expect(config.env).toEqual({PATH:'/bin',LD_LIBRARY_PATH:'/apk/lib:/app/abi',BUN_FEATURE_FLAG_DISABLE_IO_POOL:'1',MSGPACKR_NATIVE_ACCELERATION_DISABLED:'true'});
+ expect(smithersStateRoot(env,'/assets')).toBe('/app/state/smthrs');
+ for(const key of ['LD_PATH','BUN_PATH','LD_LIBRARY_PATH','AGENT_ROOT'])expect(()=>smithersProcessConfig('/source',{...env,[key]:''})).toThrow();
+ expect(()=>smithersProcessConfig('/source',{...env,LD_LIBRARY_PATH:'/apk/lib:.'})).toThrow();
+ expect(()=>smithersStateRoot({...env,ELIZA_STATE_DIR:undefined})).toThrow();
+});
+
+test('browser launch and existing state location remain compatible', () => {
+ const config=smithersProcessConfig('/source/plugin',{BUN_BIN:'/host/bun',HOME:'/profile',ELIZA_STATE_DIR:'/profile',LD_PATH:'/ignored'},'/other',true);
+ expect(config.command).toBe('/host/bun');expect(config.prefix).toEqual([]);expect(config.cwd).toBe('/source/plugin');
+ expect(config.env.LD_PATH).toBeUndefined();expect(config.packaged).toBe(false);
+ expect(smithersStateRoot({ELIZA_STATE_DIR:'/profile'},'/profile')).toBe('/profile/.eliza/smthrs');
+ expect(smithersProcessConfig('/source',{},'/current/bun',true).command).toBe('/current/bun');
+ expect(smithersProcessConfig('/source',{},'/node',false).command).toBe('bun');
+ expect(()=>smithersProcessConfig('/source',{ELIZA_SMTHRS_RUNTIME_DIR:'relative'})).toThrow();
+ expect(()=>smithersStateRoot({ELIZA_SMTHRS_STATE_DIR:'relative'})).toThrow();
+});
+
+test('dependency links recover across install moves without changing durable state', async () => {
+ const root=await mkdtemp(join(tmpdir(),'smithers-install-'));
+ try {
+  const state=join(root,'state'),old=join(root,'old'),next=join(root,'new');
+  await mkdir(state);await mkdir(old);await mkdir(next);
+  await writeFile(join(state,'runs.sqlite'),'durable-state-marker');
+  await linkSmithersDependency(state,'smthrs',old);await rm(old,{recursive:true});
+  await linkSmithersDependency(state,'smthrs',next);
+  expect(await readlink(join(state,'node_modules/smthrs'))).toBe(next);
+  await linkSmithersDependency(state,'smthrs',next);
+  expect(await readFile(join(state,'runs.sqlite'),'utf8')).toBe('durable-state-marker');
+  await mkdir(join(state,'node_modules/zod'));
+  await expect(linkSmithersDependency(state,'zod',next)).rejects.toThrow('non-link');
+ }finally{await rm(root,{recursive:true,force:true});}
+});
