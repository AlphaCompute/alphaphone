+import {test, expect} from 'bun:test';
+import {mkdtemp, cp, rm, readlink} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {runSmithersWorkflow, controlSmithersRun, resolveSmithersWorkflowDir} from '../src/services/smithers-runtime';
+import type {WorkflowDefinitionResponse} from '../src/types/index';
+
+test.skipIf(!process.env.ALPHA_WORKFLOW_WORKER_OUTPUT)('packaged executor controls and preserves pending state across installation moves', async () => {
+ const temporary=await mkdtemp(join(tmpdir(),'eliza-packaged-worker-'));
+ const before={runtime:process.env.ELIZA_SMTHRS_RUNTIME_DIR,state:process.env.ELIZA_SMTHRS_STATE_DIR};
+ const old=join(temporary,'old-install'),next=join(temporary,'new-install');
+ try {
+  await cp(process.env.ALPHA_WORKFLOW_WORKER_OUTPUT!,old,{recursive:true});
+  process.env.ELIZA_SMTHRS_RUNTIME_DIR=old;process.env.ELIZA_SMTHRS_STATE_DIR=join(temporary,'state');
+  const workflow: WorkflowDefinitionResponse={id:'guarded',name:'Packaged test',active:true,language:'tsx',steps:[],widgets:[],createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),versionId:'v1',source:`/** @jsxImportSource smthrs */
+import {createSmithers} from 'smthrs/create';
+import {approvalDecisionSchema} from 'smthrs';
+import {z} from 'zod';
+const {Workflow,Sequence,Approval,Task,smithers,outputs}=createSmithers({decision:approvalDecisionSchema,output:z.object({text:z.string()})},{dbPath:process.env.ELIZA_SMTHRS_DB_PATH});
+export default smithers(()=><Workflow name="packaged"><Sequence><Approval id="review" output={outputs.decision} request={{title:'Review synthetic text'}}/><Task id="reply" output={outputs.output} agent={globalThis.__elizaSmithers.agent}>Return synthetic text.</Task></Sequence></Workflow>);`};
+  let calls=0;
+  const request={tenantId:'artifact-owner',workflow,runId:'approval-update',mode:'manual' as const,input:{},timeoutMs:60000,generate:async()=>{calls++;return '{"text":"Synthetic approved result"}';}};
+  const waiting=await runSmithersWorkflow(request);expect(waiting.status,JSON.stringify(waiting.error)).toBe('waiting-approval');expect(calls).toBe(0);
+  const iteration=waiting.events.find(event=>event.nodeId==='review'&&Number.isInteger(event.iteration))?.iteration;
+  expect(Number.isInteger(iteration)).toBe(true);
+  await cp(old,next,{recursive:true});await rm(old,{recursive:true});process.env.ELIZA_SMTHRS_RUNTIME_DIR=next;
+  expect((await runSmithersWorkflow(request)).status).toBe('waiting-approval');expect(calls).toBe(0);
+  expect(await readlink(join(resolveSmithersWorkflowDir(request.tenantId,workflow.id),'node_modules/smthrs'))).toBe(join(next,'node_modules/smthrs'));
+  await controlSmithersRun(request.tenantId,workflow.id,{kind:'approve',runId:request.runId,nodeId:'review',iteration:iteration!});
+  const completed=await runSmithersWorkflow(request);expect(completed.status,JSON.stringify(completed.error)).toBe('finished');expect(calls).toBe(1);
+  expect((await runSmithersWorkflow(request)).status).toBe('finished');expect(calls).toBe(1);
+  for(const kind of ['deny','cancel'] as const){
+   const deniedRequest={...request,runId:kind};const parked=await runSmithersWorkflow(deniedRequest);expect(parked.status).toBe('waiting-approval');
+   const it=parked.events.find(event=>event.nodeId==='review'&&Number.isInteger(event.iteration))?.iteration;expect(Number.isInteger(it)).toBe(true);
+   await controlSmithersRun(request.tenantId,workflow.id,kind==='cancel'?{kind,runId:kind}:{kind,runId:kind,nodeId:'review',iteration:it!});
+   expect((await runSmithersWorkflow(deniedRequest)).status).toBe(kind==='deny'?'failed':'cancelled');expect(calls).toBe(1);
+  }
+ }finally{
+  for(const [key,value] of [['ELIZA_SMTHRS_RUNTIME_DIR',before.runtime],['ELIZA_SMTHRS_STATE_DIR',before.state]]){if(value===undefined)delete process.env[key!];else process.env[key!]=value;}
+  await rm(temporary,{recursive:true,force:true});
+ }
+},120000);
