index 0000000..40472fa
--- /dev/null
+++ b/plugins/plugin-workflow/src/services/smithers-process.ts
@@ -0,0 +1,64 @@
+import {randomUUID} from 'node:crypto';
+import {lstat, mkdir, readlink, rename, symlink, unlink} from 'node:fs/promises';
+import {isAbsolute, join, resolve} from 'node:path';
+
+type Environment = Record<string, string | undefined>;
+const nativeFlags = ['BUN_FEATURE_FLAG_DISABLE_IO_POOL', 'BUN_FEATURE_FLAG_FORCE_WAITER_THREAD',
+  'BUN_FEATURE_FLAG_DISABLE_RWF_NONBLOCK', 'BUN_FEATURE_FLAG_DISABLE_SPAWNSYNC_FAST_PATH',
+  'BUN_FEATURE_FLAG_DISABLE_ASYNC_TRANSPILER'];
+function absolute(value: string | undefined, name: string): string {
+  if (!value || !isAbsolute(value)) throw new Error(`${name} must be an absolute path`);
+  return value;
+}
+
+export function smithersProcessConfig(pluginRoot: string, env: Environment = process.env,
+  executable = process.execPath, isBun = !!process.versions.bun) {
+  const android = env.ELIZA_PLATFORM === 'android' || env.ELIZA_MOBILE_PLATFORM === 'android';
+  const runtime = env.ELIZA_SMTHRS_RUNTIME_DIR || (android
+    ? join(absolute(env.AGENT_ROOT, 'AGENT_ROOT'), 'workflow-worker') : undefined);
+  const cwd = runtime ? absolute(runtime, 'ELIZA_SMTHRS_RUNTIME_DIR') : pluginRoot;
+  const childEnv: Environment = Object.fromEntries(['PATH', 'HOME', 'TMPDIR', 'NODE_ENV']
+    .filter(key => env[key] !== undefined).map(key => [key, env[key]]));
+  let command = env.BUN_BIN?.trim() || (isBun ? executable : 'bun');
+  const prefix: string[] = [];
+  if (android) {
+    command = absolute(env.LD_PATH, 'LD_PATH');
+    prefix.push(absolute(env.BUN_PATH, 'BUN_PATH'));
+    if (!env.LD_LIBRARY_PATH || env.LD_LIBRARY_PATH.split(':').some(path => !isAbsolute(path))) {
+      throw new Error('LD_LIBRARY_PATH must contain absolute library directories');
+    }
+    childEnv.LD_LIBRARY_PATH = env.LD_LIBRARY_PATH;
+    for (const key of nativeFlags) if (env[key] !== undefined) childEnv[key] = env[key];
+  }
+  childEnv.MSGPACKR_NATIVE_ACCELERATION_DISABLED = 'true';
+  return {command, prefix, cwd, env: childEnv, packaged: !!runtime};
+}
+
+export function smithersStateRoot(env: Environment = process.env, cwd = process.cwd()): string {
+  if (env.ELIZA_SMTHRS_STATE_DIR) return absolute(env.ELIZA_SMTHRS_STATE_DIR, 'ELIZA_SMTHRS_STATE_DIR');
+  if (env.ELIZA_PLATFORM === 'android' || env.ELIZA_MOBILE_PLATFORM === 'android') {
+    return join(absolute(env.ELIZA_STATE_DIR, 'ELIZA_STATE_DIR'), 'smthrs');
+  }
+  // Preserve existing browser/desktop workflow databases at their legacy location.
+  return join(cwd, '.eliza', 'smthrs');
+}
+
+export async function linkSmithersDependency(root: string, name: 'smthrs' | 'zod', target: string) {
+  const link = join(root, 'node_modules', name);
+  await mkdir(join(root, 'node_modules'), {recursive: true});
+  let current;
+  try {current = await lstat(link);} catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+  }
+  if (current) {
+    if (!current.isSymbolicLink()) throw new Error(`Refusing to replace non-link workflow dependency: ${name}`);
+    if (resolve(join(root, 'node_modules'), await readlink(link)) === resolve(target)) return;
+  }
+  const temporary = `${link}.${randomUUID()}.new`;
+  try {
+    await symlink(target, temporary, 'junction');
+    await rename(temporary, link);
+  } finally {
+    await unlink(temporary).catch((error: NodeJS.ErrnoException) => {if (error.code !== 'ENOENT') throw error;});
+  }
+}
