{
  "name": "@eliza-research/alphaphone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "android:verify": "node scripts/verify-apks.mjs",
    "android:smoke": "node scripts/android-smoke.mjs",
    "aosp:stage": "node scripts/stage-aosp.mjs",
    "upstream:verify": "node scripts/verify-upstream.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "@fontsource/public-sans": "^5.2.0",
    "@fontsource/fraunces": "^5.2.0"
  }
}
