<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <!-- Standalone APKs have no Phone, Contacts or SMS (P-36): no contacts or phone-state access is
      declared, whatever a shared library manifest lists. -->
 <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
 <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
 <!-- These are removal markers, not permission requests. The merged standalone
      manifest and APK verifier still require all three permissions to be absent. -->
 <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
 <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
 <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
</manifest>
