<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <instrumentation android:name="androidx.test.runner.AndroidJUnitRunner"
    android:targetPackage="ai.elizaresearch.alphaphone" />
  <instrumentation android:name="ai.elizaresearch.alphaphone.WorkflowNoticeProcessRunner"
    android:targetPackage="ai.elizaresearch.alphaphone"
    android:targetProcesses="ai.elizaresearch.alphaphone:workflowNoticeTest" />
  <application>
    <activity android:name="ai.elizaresearch.alphaphone.ShareReceiverActivity"
      android:exported="true" android:label="Alpha share verification">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/jpeg" />
      </intent-filter>
    </activity>
    <!-- Bound only while AccessibilityInstrumentedTest performs its accessibility click, so that
         WebView is in the accessibility mode a screen reader gets. Never part of an app APK. -->
    <service android:name="ai.elizaresearch.alphaphone.ScreenReaderStandInService"
      android:exported="true" android:label="Alpha screen reader stand-in (test)"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/screen_reader_stand_in" />
    </service>
  </application>
</manifest>
