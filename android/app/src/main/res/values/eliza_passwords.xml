<?xml version="1.0" encoding="utf-8"?>
<!-- Alpha identity for the shared plugin-native-passwords vault and Autofill provider.
     Installed-data contract: never change the directory, alias or AAD in place. -->
<resources>
    <string name="eliza_passwords_vault_directory" translatable="false">passwords</string>
    <string name="eliza_passwords_key_alias" translatable="false">alpha.passwords.vault.v1</string>
    <string name="eliza_passwords_vault_aad" translatable="false">alpha.passwords.vault.v1</string>
    <integer name="eliza_passwords_unlock_seconds">60</integer>
    <bool name="eliza_passwords_allow_biometric">true</bool>
    <!-- The pinned PasswordFormPolicy requires the committed top-level origin and a native
         per-field origin for every login field. Android WebView's own structure has no field
         origins and is refused ("Field origin unavailable"). Where the WebView supports
         isolated-world scripts and message listeners, BrowserLoginFields reports each login field
         with the engine's sourceOrigin for its frame (top level and same-origin frames only). -->
    <bool name="eliza_passwords_host_is_browser">true</bool>
    <string name="eliza_passwords_token_scheme" translatable="false">alphaphone-passwords</string>
    <string name="eliza_passwords_service_label">Alpha Phone passwords</string>
</resources>
