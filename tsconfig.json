{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@elizaos/contracts/native-notes-query": [
        "./.eliza/client-features/packages/contracts/src/native-notes-query.ts"
      ],
      "@elizaos/voice": [
        "./.eliza/client-features/packages/voice/src/batch-protocol.ts"
      ],
      "@elizaos/core/protocol": [
        "./.eliza/client-features/packages/core/src/voice-protocol.ts"
      ]
    }
  },
  "include": [
    "apps/app/src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
